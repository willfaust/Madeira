diff --git a/dlls/xinput1_3/unixlib.h b/dlls/xinput1_3/unixlib.h
new file mode 100644
index 0000000..9fce674
--- /dev/null
+++ b/dlls/xinput1_3/unixlib.h
@@ -0,0 +1,64 @@
+/*
+ * iOS-Madeira: XInput host-pad unix interface
+ *
+ * On iOS there is no winebus / hidclass stack, so xinput can't find a HID
+ * device. Instead the host app (GameController.framework) publishes pad
+ * state into a table on the unix side, and xinput reads it through these
+ * calls. On any other platform __wine_init_unix_call fails (no unixlib is
+ * built for xinput) and the normal HID path is used unchanged.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WINE_XINPUT_UNIXLIB_H
+#define __WINE_XINPUT_UNIXLIB_H
+
+#include "windef.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+
+/* Bumped whenever the structs below change shape; the PE side refuses a
+ * host table built against a different layout. */
+#define XINPUT_HOST_ABI 1
+
+struct xinput_host_probe_params
+{
+    UINT32 abi;             /* out */
+};
+
+struct xinput_host_state_params
+{
+    UINT32 index;           /* in */
+    UINT32 connected;       /* out */
+    UINT32 packet;          /* out: changes whenever state changes */
+    UINT16 buttons;         /* out: XINPUT_GAMEPAD_* incl. 0x0400 guide */
+    BYTE   left_trigger;    /* out */
+    BYTE   right_trigger;   /* out */
+    INT16  thumb_lx;        /* out */
+    INT16  thumb_ly;        /* out */
+    INT16  thumb_rx;        /* out */
+    INT16  thumb_ry;        /* out */
+    UINT16 vendor_id;       /* out */
+    UINT16 product_id;      /* out */
+    UINT32 has_rumble;      /* out */
+};
+
+struct xinput_host_vibration_params
+{
+    UINT32 index;           /* in */
+    UINT16 left_motor;      /* in */
+    UINT16 right_motor;     /* in */
+};
+
+enum xinput_host_funcs
+{
+    unix_xinput_host_probe,
+    unix_xinput_host_get_state,
+    unix_xinput_host_set_vibration,
+    unix_xinput_host_funcs_count,
+};
+
+#endif /* __WINE_XINPUT_UNIXLIB_H */
