+/* iOS-Madeira: host pad mode. When the process has an xinput unixlib that
+ * answers the probe (Madeira links one, fed by GameController.framework),
+ * pads come from the host instead of the HID stack: there is no winebus on
+ * iOS, so the HID path would never find a device. Elsewhere the probe fails
+ * and nothing below is used. */
+static BOOL host_mode;
+static const HANDLE host_device = (HANDLE)(ULONG_PTR)0x6d616465; /* never opened */
+
+static void host_init(void)
+{
+    struct xinput_host_probe_params params = {0};
+
+    if (__wine_init_unix_call()) return;
+    if (WINE_UNIX_CALL(unix_xinput_host_probe, &params)) return;
+    if (params.abi != XINPUT_HOST_ABI)
+    {
+        ERR("host pad abi %u, expected %u; using HID\n", params.abi, XINPUT_HOST_ABI);
+        return;
+    }
+    TRACE("using host pads\n");
+    host_mode = TRUE;
+}
+
+static DWORD host_set_state(struct xinput_controller *controller, XINPUT_VIBRATION *state)
+{
+    struct xinput_host_vibration_params params = {.index = controller - controllers};
+
+    if (!(controller->caps.Flags & XINPUT_CAPS_FFB_SUPPORTED)) return ERROR_SUCCESS;
+
+    controller->vibration = *state;
+    if (!controller->enabled) return ERROR_SUCCESS;
+
+    params.left_motor = state->wLeftMotorSpeed;
+    params.right_motor = state->wRightMotorSpeed;
+    WINE_UNIX_CALL(unix_xinput_host_set_vibration, &params);
+    return ERROR_SUCCESS;
+}
+
+/* Called with controller->crit held. Pulls the host pad into the slot and
+ * makes controller->device reflect whether it is connected, so the rest of
+ * the file can keep treating a non-NULL device as "present". */
+static void host_sync(struct xinput_controller *controller)
+{
+    struct xinput_host_state_params params = {.index = controller - controllers};
+
+    if (WINE_UNIX_CALL(unix_xinput_host_get_state, &params) || !params.connected)
+    {
+        controller->device = NULL;
+        return;
+    }
+
+    if (!controller->device)
+    {
+        memset(&controller->caps, 0, sizeof(controller->caps));
+        controller->caps.Type = XINPUT_DEVTYPE_GAMEPAD;
+        controller->caps.SubType = XINPUT_DEVSUBTYPE_GAMEPAD;
+        controller->caps.Gamepad.wButtons = 0xffff;
+        controller->caps.Gamepad.bLeftTrigger = 0xff;
+        controller->caps.Gamepad.bRightTrigger = 0xff;
+        controller->caps.Gamepad.sThumbLX = (SHORT)0xffc0;
+        controller->caps.Gamepad.sThumbLY = (SHORT)0xffc0;
+        controller->caps.Gamepad.sThumbRX = (SHORT)0xffc0;
+        controller->caps.Gamepad.sThumbRY = (SHORT)0xffc0;
+        memset(&controller->state, 0, sizeof(controller->state));
+        memset(&controller->last_keystroke, 0, sizeof(controller->last_keystroke));
+        memset(&controller->vibration, 0, sizeof(controller->vibration));
+        controller->enabled = TRUE;
+        controller->device = host_device;
+        TRACE("host pad %Iu connected, vid %04x pid %04x\n", (ULONG_PTR)(controller - controllers),
+              params.vendor_id, params.product_id);
+    }
+
+    controller->host_vendor_id = params.vendor_id;
+    controller->host_product_id = params.product_id;
+
+    /* Slot 0 can gain or lose rumble while connected (touch pad <-> real pad). */
+    if (params.has_rumble)
+    {
+        controller->caps.Flags |= XINPUT_CAPS_FFB_SUPPORTED;
+        controller->caps.Vibration.wLeftMotorSpeed = 0xff;
+        controller->caps.Vibration.wRightMotorSpeed = 0xff;
+    }
+    else
+    {
+        controller->caps.Flags &= ~XINPUT_CAPS_FFB_SUPPORTED;
+        controller->caps.Vibration.wLeftMotorSpeed = 0;
+        controller->caps.Vibration.wRightMotorSpeed = 0;
+    }
+
+    if (!controller->enabled)
+    {
+        /* XInputEnable(FALSE): report a neutral pad, as Windows does. */
+        memset(&controller->state.Gamepad, 0, sizeof(controller->state.Gamepad));
+        return;
+    }
+
+    controller->state.dwPacketNumber = params.packet;
+    controller->state.Gamepad.wButtons = params.buttons;
+    controller->state.Gamepad.bLeftTrigger = params.left_trigger;
+    controller->state.Gamepad.bRightTrigger = params.right_trigger;
+    controller->state.Gamepad.sThumbLX = params.thumb_lx;
+    controller->state.Gamepad.sThumbLY = params.thumb_ly;
+    controller->state.Gamepad.sThumbRX = params.thumb_rx;
+    controller->state.Gamepad.sThumbRY = params.thumb_ry;
+}
