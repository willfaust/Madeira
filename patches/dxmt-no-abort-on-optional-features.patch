   HRESULT
   STDMETHODCALLTYPE
-  GetRestrictToOutput(IDXGIOutput **ppRestrictToOutput) final { IMPLEMENT_ME; };
+  GetRestrictToOutput(IDXGIOutput **ppRestrictToOutput) final {
+    if (ppRestrictToOutput == nullptr)
+      return E_INVALIDARG;
+    /* The swap chain presents into the application's view, so it is never
+     * restricted to one output. NULL is the documented answer for that. */
+    *ppRestrictToOutput = nullptr;
+    return S_OK;
+  };
 
   HRESULT
   STDMETHODCALLTYPE
-  SetBackgroundColor(const DXGI_RGBA *pColor) final { IMPLEMENT_ME; };
+  SetBackgroundColor(const DXGI_RGBA *pColor) final {
+    if (pColor == nullptr)
+      return E_INVALIDARG;
+    background_color_ = *pColor;
+    return S_OK;
+  };
 
   HRESULT
   STDMETHODCALLTYPE
-  GetBackgroundColor(DXGI_RGBA *pColor) final { IMPLEMENT_ME; };
+  GetBackgroundColor(DXGI_RGBA *pColor) final {
+    if (pColor == nullptr)
+      return E_INVALIDARG;
+    *pColor = background_color_;
+    return S_OK;
+  };
 
   HRESULT
   STDMETHODCALLTYPE
-  SetRotation(DXGI_MODE_ROTATION Rotation) final { IMPLEMENT_ME; };
+  SetRotation(DXGI_MODE_ROTATION Rotation) final {
+    switch (Rotation) {
+    case DXGI_MODE_ROTATION_UNSPECIFIED:
+    case DXGI_MODE_ROTATION_IDENTITY:
+      rotation_ = DXGI_MODE_ROTATION_IDENTITY;
+      return S_OK;
+    case DXGI_MODE_ROTATION_ROTATE90:
+    case DXGI_MODE_ROTATION_ROTATE180:
+    case DXGI_MODE_ROTATION_ROTATE270:
+      /* DXMT has no rotation stage: it composites the back buffer into the
+       * view as-is. Reporting success here would turn into a sideways frame
+       * that nothing in the log explains, so refuse the rotations instead of
+       * accepting them to no effect. GetRotation keeps returning IDENTITY. */
+      WARN("SetRotation: rotating the presented image is not supported");
+      return E_NOTIMPL;
+    }
+    return E_INVALIDARG;
+  };
 
   HRESULT
   STDMETHODCALLTYPE
-  GetRotation(DXGI_MODE_ROTATION *pRotation) final { IMPLEMENT_ME; };
+  GetRotation(DXGI_MODE_ROTATION *pRotation) final {
+    if (pRotation == nullptr)
+      return E_INVALIDARG;
+    *pRotation = rotation_;
+    return S_OK;
+  };
 
   HRESULT STDMETHODCALLTYPE SetSourceSize(UINT width, UINT height) override {
-    IMPLEMENT_ME
-    return S_OK;
+    if (width == 0 || height == 0)
+      return E_INVALIDARG;
+    /* Source size is the sub-rectangle of the back buffer that gets scaled up to
+     * the output -- the API a title uses for dynamic resolution. DXMT presents
+     * the whole back buffer, so accepting a smaller one would have the title
+     * render its frame into the top-left corner of a backdrop it believes is
+     * being scaled, which reads as a badly framed, broken image. Refusing keeps
+     * the title at native resolution, where its output is correct. */
+    if (width == backbuffer_desc_.Width && height == backbuffer_desc_.Height)
+      return S_OK;
+    WARN("SetSourceSize: dynamic resolution scaling is not supported");
+    return E_NOTIMPL;
   };
 
   HRESULT STDMETHODCALLTYPE GetSourceSize(UINT *width, UINT *height) override {
-    IMPLEMENT_ME
+    if (width == nullptr || height == nullptr)
+      return E_INVALIDARG;
+    /* True by construction: with no scaling stage the whole back buffer is the
+     * source. Consistent with SetSourceSize, which only accepts that size. */
+    *width = backbuffer_desc_.Width;
+    *height = backbuffer_desc_.Height;
     return S_OK;
   };
 
