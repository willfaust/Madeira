    "This installation can only wait about 30 seconds in the background, so go to Settings straight away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Installation kann im Hintergrund nur etwa 30 Sekunden warten, also geh sofort zu den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalación solo puede esperar unos 30 segundos en segundo plano, así que ve a Ajustes enseguida."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치는 백그라운드에서 약 30초만 기다릴 수 있으니 바로 설정으로 가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalação só pode esperar uns 30 segundos em segundo plano, então vá aos Ajustes logo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта установка может ждать в фоне всего около 30 секунд, поэтому сразу перейдите в Настройки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个安装只能在后台等大约 30 秒，所以请立刻前往「设置」。"
          }
        }
      }
