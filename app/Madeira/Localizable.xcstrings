    "One key = value per line, as in madeira.cfg; lines starting with # are comments. Examples: fence-chain = 6, dxmt = d3d11.mipClampBC=1, env.FEX_MULTIBLOCK = 1.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schlüssel = Wert pro Zeile, wie in madeira.cfg; Zeilen, die mit # beginnen, sind Kommentare. Beispiele: fence-chain = 6, dxmt = d3d11.mipClampBC=1, env.FEX_MULTIBLOCK = 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave = valor por línea, como en madeira.cfg; las líneas que empiezan por # son comentarios. Ejemplos: fence-chain = 6, dxmt = d3d11.mipClampBC=1, env.FEX_MULTIBLOCK = 1."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "madeira.cfg처럼 한 줄에 key = value 하나씩 적습니다. #으로 시작하는 줄은 주석입니다. 예: fence-chain = 6, dxmt = d3d11.mipClampBC=1, env.FEX_MULTIBLOCK = 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave = valor por linha, como no madeira.cfg; linhas que começam com # são comentários. Exemplos: fence-chain = 6, dxmt = d3d11.mipClampBC=1, env.FEX_MULTIBLOCK = 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один ключ = значение на строку, как в madeira.cfg; строки, начинающиеся с #, — комментарии. Примеры: fence-chain = 6, dxmt = d3d11.mipClampBC=1, env.FEX_MULTIBLOCK = 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个 key = value，与 madeira.cfg 相同；以 # 开头的行是注释。例如：fence-chain = 6，dxmt = d3d11.mipClampBC=1，env.FEX_MULTIBLOCK = 1。"
          }
        }
      }
    },
