    "DXMT draws Direct3D 10 and 11 on Metal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT zeichnet Direct3D 10 und 11 auf Metal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT dibuja Direct3D 10 y 11 sobre Metal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT가 Direct3D 10과 11을 Metal에서 그립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DXMT desenha Direct3D 10 e 11 sobre Metal."
          }
        },
        "ru": {
