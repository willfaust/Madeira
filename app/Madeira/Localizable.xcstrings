          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 帧"
          }
        }
      }
    },
    "32-bit games run DXMT's Direct3D 9 frontend as native ARM64 code; 64-bit games are unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "32-Bit-Spiele führen das Direct3D-9-Frontend von DXMT als nativen ARM64-Code aus; 64-Bit-Spiele bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos de 32 bits ejecutan el frontend Direct3D 9 de DXMT como código ARM64 nativo; los de 64 bits no cambian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "32비트 게임은 DXMT의 Direct3D 9 프런트엔드를 네이티브 ARM64 코드로 실행합니다. 64비트 게임은 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos de 32 bits executam o frontend Direct3D 9 do DXMT como código ARM64 nativo; jogos de 64 bits não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "32-битные игры выполняют фронтенд Direct3D 9 из DXMT как нативный код ARM64; 64-битные игры не меняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "32 位游戏以原生 ARM64 代码运行 DXMT 的 Direct3D 9 前端；64 位游戏不受影响。"
          }
        }
      }
    },
    "40 FPS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "40 FPS"
          }
        },
