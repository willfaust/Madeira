    },
    "StikDebug needs a pairing file and an active LocalDevVPN connection. Madeira sends its own script automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug braucht eine Kopplungsdatei und eine aktive LocalDevVPN-Verbindung. Madeira sendet sein eigenes Skript automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug necesita un archivo de emparejamiento y una conexión LocalDevVPN activa. Madeira envía su propio script automáticamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug에는 페어링 파일과 활성 LocalDevVPN 연결이 필요합니다. Madeira가 자체 스크립트를 자동으로 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O StikDebug precisa de um arquivo de pareamento e de uma conexão LocalDevVPN ativa. O Madeira envia seu próprio script automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug нужен файл сопряжения и активное подключение LocalDevVPN. Madeira отправляет свой скрипт автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug 需要配对文件和可用的 LocalDevVPN 连接。Madeira 会自动发送自己的脚本。"
          }
        }
      }
    },
