    "Drag the pointer like a trackpad. Tap to click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger wie mit einem Trackpad ziehen. Zum Klicken tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el puntero como en un trackpad. Toca para hacer clic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드처럼 포인터를 끕니다. 탭하면 클릭합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
