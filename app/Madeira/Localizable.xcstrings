          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Steam 上查找"
          }
        }
      }
    },
    "Finished files are kept. Try again to continue where it stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertige Dateien bleiben erhalten. Versuche es erneut, um dort weiterzumachen, wo es aufgehört hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos terminados se conservan. Vuelve a intentarlo para seguir donde se detuvo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 파일은 유지됩니다. 다시 시도하면 멈춘 곳부터 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos concluídos são mantidos. Tente de novo para continuar de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовые файлы сохраняются. Повторите, чтобы продолжить с места остановки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的文件会保留。再次尝试可从断点继续。"
          }
        }
      }
    },
    "Flowing chrome on the bars and the Desktop button. Off, they use the system's Liquid Glass.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fließendes Chrom auf den Leisten und der Desktop-Taste. Aus: Sie nutzen das Liquid Glass des Systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cromo fluido en las barras y el botón Escritorio. Desactivado, usan el Liquid Glass del sistema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막대와 데스크톱 버튼에 흐르는 금속 효과를 씁니다. 끄면 시스템의 Liquid Glass를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cromo fluido nas barras e no botão Área de trabalho. Desativado, elas usam o Liquid Glass do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Струящийся хром на панелях и кнопке «Рабочий стол». Если выключено, используется системное Liquid Glass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栏与桌面按钮上的流动玻璃效果。关闭后使用系统的液态玻璃。"
          }
        }
      }
    },
    "Folder size": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnergröße"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de la carpeta"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 크기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho da pasta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер папки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹体积"
          }
        }
      }
    },
    "For Unity games that crash while loading, like Megabonk. Can make other games freeze": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Unity-Spiele, die beim Laden abstürzen, wie Megabonk. Kann andere Spiele einfrieren lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para juegos Unity que se cierran al cargar, como Megabonk. Puede congelar otros juegos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Megabonk처럼 로딩 중 충돌하는 Unity 게임용. 다른 게임은 멈출 수 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jogos Unity que travam ao carregar, como Megabonk. Pode congelar outros jogos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для игр Unity, которые вылетают при загрузке, например Megabonk. Другие игры могут зависать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于加载时崩溃的 Unity 游戏，例如 Megabonk。可能让其他游戏卡死"
          }
        }
      }
    },
    "For a game whose launcher closes Madeira when it starts the game (Fallout: New Vegas): pick the game's own program.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Spiel, dessen Launcher Madeira beim Starten des Spiels schließt (Fallout: New Vegas): Wähle das eigene Programm des Spiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un juego cuyo launcher cierra Madeira al iniciar el juego (Fallout: New Vegas): elige el programa propio del juego."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 시작할 때 런처가 Madeira를 닫는 게임(Fallout: New Vegas)용: 게임 자체 프로그램을 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um jogo cujo launcher fecha o Madeira ao iniciar o jogo (Fallout: New Vegas): escolha o programa do próprio jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для игры, лаунчер которой закрывает Madeira при запуске игры (Fallout: New Vegas): выберите собственную программу игры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于启动游戏时启动器会关闭 Madeira 的游戏（如《辐射：新维加斯》）：请选游戏自身的程序。"
          }
        }
      }
    },
    "For an installer that finished its work but never closed, so Madeira never saw it end. At the next start the game's own install-script programs are recorded as done, as a finished run would be, and are not run again. Nothing is installed or removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Installer, der seine Arbeit beendet, sich aber nie geschlossen hat, sodass Madeira sein Ende nie gesehen hat. Beim nächsten Start werden die Installationsskript-Programme des Spiels als erledigt vermerkt, wie nach einem abgeschlossenen Lauf, und nicht erneut ausgeführt. Nichts wird installiert oder entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un instalador que terminó su trabajo pero nunca se cerró, así que Madeira nunca vio que acabara. En el próximo inicio, los programas del script de instalación del juego se marcan como hechos, como tras una ejecución completa, y no se vuelven a ejecutar. No se instala ni se quita nada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 끝났지만 닫히지 않아 Madeira가 끝난 것을 보지 못한 설치 프로그램용입니다. 다음 시작 때 게임의 설치 스크립트 프로그램을 정상적으로 끝난 것처럼 완료로 기록하고 다시 실행하지 않습니다. 아무것도 설치하거나 제거하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um instalador que terminou o trabalho mas nunca fechou, então o Madeira nunca viu o fim. No próximo início, os programas do script de instalação do jogo são registrados como concluídos, como numa execução terminada, e não rodam de novo. Nada é instalado ou removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для установщика, который закончил работу, но так и не закрылся, поэтому Madeira не увидела его завершения. При следующем запуске программы из установочного скрипта игры будут отмечены как выполненные, как после завершённого запуска, и больше не запустятся. Ничего не устанавливается и не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于安装程序已完成却始终没关闭，导致 Madeira 一直没看到它结束的情况。下次启动时，游戏自带的安装脚本程序会被记为已完成（如同跑完一次），不再重复运行。不会安装或删除任何东西。"
          }
        }
      }
    },
    "For anything not listed, such as env.FEX_TSOENABLED = 1.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für alles, was nicht aufgeführt ist, etwa env.FEX_TSOENABLED = 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para todo lo que no aparece, como env.FEX_TSOENABLED = 1."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 없는 항목용(예: env.FEX_TSOENABLED = 1)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tudo o que não está listado, como env.FEX_TSOENABLED = 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для всего, чего нет в списке, например env.FEX_TSOENABLED = 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于未列出的项目，例如 env.FEX_TSOENABLED = 1。"
          }
        }
      }
    },
    "For games that quit with c000001d": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Spiele, die mit c000001d beendet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para juegos que se cierran con c000001d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c000001d로 종료되는 게임용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jogos que fecham com c000001d"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для игр, которые завершаются с c000001d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于以 c000001d 退出的游戏"
          }
        }
      }
    },
    "For older games that read the pad through DirectInput.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ältere Spiele, die das Gamepad über DirectInput lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para juegos antiguos que leen el mando mediante DirectInput."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DirectInput으로 패드를 읽는 오래된 게임용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jogos antigos que leem o controle pelo DirectInput."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для старых игр, которые читают геймпад через DirectInput."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于通过 DirectInput 读手柄的老游戏。"
          }
        }
      }
    },
    "For requests of 64 GB or more. Backs up to 16 GB by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Anfragen ab 64 GB. Standardmäßig bis zu 16 GB hinterlegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitudes de 64 GB o más. Respalda hasta 16 GB por defecto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "64GB 이상 요청에 사용. 기본적으로 최대 16GB까지 확보합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedidos de 64 GB ou mais. Reserva até 16 GB por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запросов от 64 ГБ. По умолчанию обеспечивает до 16 ГБ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 64 GB 及以上的申请。默认最多备份 16 GB。"
          }
        }
      }
    },
    "Force close Madeira": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira beenden erzwingen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar cierre de Madeira"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira 강제 종료"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forçar o fechamento do Madeira"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
