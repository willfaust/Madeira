    "Restart Madeira (close it from the app switcher) for changes to apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Madeira neu (schließe es im App-Umschalter), damit die Änderungen gelten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Madeira (ciérrala desde el selector de apps) para que se apliquen los cambios."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 적용하려면 Madeira를 다시 시작하세요(앱 전환기에서 닫기)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Madeira (feche-o no seletor de apps) para as mudanças valerem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите Madeira (закройте её в переключателе приложений), чтобы изменения вступили в силу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启 Madeira（从后台多任务关闭它）后改动才会生效。"
          }
        }
      }
    },
    "Restart Madeira (close it from the app switcher) for these changes to apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Madeira neu (schließe es im App-Umschalter), damit diese Änderungen gelten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Madeira (ciérrala desde el selector de apps) para que se apliquen estos cambios."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경 사항을 적용하려면 Madeira를 다시 시작하세요(앱 전환기에서 닫기)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
