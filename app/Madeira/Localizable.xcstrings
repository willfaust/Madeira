      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinstallieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstalar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstalar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        }
      }
    },
    "Uninstall %@? Its downloaded files are deleted from this device. Saves stored elsewhere are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deinstallieren? Die geladenen Dateien werden von diesem Gerät gelöscht. Anderswo gespeicherte Spielstände bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desinstalar %1$@? Sus archivos descargados se eliminan de este dispositivo. Las partidas guardadas en otro lugar se conservan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 제거할까요? 다운로드한 파일이 이 기기에서 삭제됩니다. 다른 곳에 저장된 세이브는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstalar %1$@? Os arquivos baixados são apagados deste dispositivo. Saves guardados em outro lugar são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@? Скачанные файлы будут удалены с этого устройства. Сохранения в других местах останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载 %1$@？它下载的文件会从本机删除。存在别处的存档会保留。"
          }
        }
      }
    },
    "Uninstall %@? Its downloaded files are deleted from where it is installed. Saves stored elsewhere are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deinstallieren? Die geladenen Dateien werden dort gelöscht, wo es installiert ist. Anderswo gespeicherte Spielstände bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desinstalar %1$@? Sus archivos descargados se eliminan de donde está instalado. Las partidas guardadas en otro lugar se conservan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 제거할까요? 다운로드한 파일이 설치된 위치에서 삭제됩니다. 다른 곳에 저장된 세이브는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstalar %1$@? Os arquivos baixados são apagados de onde ele está instalado. Saves guardados em outro lugar são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@? Скачанные файлы будут удалены оттуда, где игра установлена. Сохранения в других местах останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载 %1$@？它下载的文件会从安装位置删除。存在别处的存档会保留。"
          }
        }
      }
    },
