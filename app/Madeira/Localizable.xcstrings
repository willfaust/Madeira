          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制关闭 Madeira"
          }
        }
      }
    },
    "Forget Apple sign-in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Anmeldung vergessen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar inicio de sesión con Apple"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인 정보 지우기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer o login com a Apple"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть вход с Apple"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 Apple 登录"
          }
        }
      }
    },
    "Frame generation (experimental)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildgenerierung (experimentell)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generación de fotogramas (experimental)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 생성(실험적)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geração de quadros (experimental)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерация кадров (экспериментально)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧生成（实验）"
          }
        }
      }
    },
    "Free games (and pay-what-you-want ones) install without buying. A paid game needs buying on itch.io first; it then shows in the library by itself, as do the games in your itch.io collections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Spiele (und Zahl-was-du-willst-Spiele) werden ohne Kauf installiert. Ein kostenpflichtiges Spiel musst du zuerst auf itch.io kaufen; danach erscheint es von selbst in der Bibliothek, ebenso die Spiele in deinen itch.io-Sammlungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos gratuitos (y los de paga lo que quieras) se instalan sin comprarlos. Un juego de pago hay que comprarlo antes en itch.io; luego aparece solo en la biblioteca, igual que los juegos de tus colecciones de itch.io."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 게임(그리고 원하는 만큼 지불하는 게임)은 구매 없이 설치됩니다. 유료 게임은 먼저 itch.io에서 구매해야 하며, 그러면 itch.io 컬렉션의 게임처럼 라이브러리에 자동으로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos grátis (e os de pague quanto quiser) são instalados sem comprar. Um jogo pago precisa ser comprado antes no itch.io; depois ele aparece sozinho na biblioteca, assim como os jogos das suas coleções do itch.io."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатные игры (и игры «плати сколько хочешь») устанавливаются без покупки. Платную игру сначала нужно купить на itch.io; затем она сама появится в библиотеке, как и игры из ваших коллекций itch.io."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费游戏（以及随意付费的）无需购买即可安装。付费游戏需先在 itch.io 购买；之后它会自动出现在库里，你的 itch.io 合集里的游戏也是。"
          }
        }
      }
    },
    "Free space on this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freier Speicher auf diesem Gerät"
          }
        },
        "es": {
