    ".NET Framework": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework"
          }
        }
      }
    },
    ".NET Framework games will not start until you download it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET-Framework-Spiele starten erst, wenn du es erneut herunterlädst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos de .NET Framework no se iniciarán hasta que lo vuelvas a descargar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET Framework 게임은 다시 다운로드할 때까지 시작되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos de .NET Framework não vão iniciar até você baixá-lo de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игры на .NET Framework не запустятся, пока вы не скачаете его снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非重新下载 .NET Framework，否则这类游戏无法启动。"
          }
        }
      }
    },
    "1 MB+ and overflow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB+ und Überlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB+ y desbordamiento"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1MB 이상 및 초과분"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB+ e excedente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 1 МБ и переполнение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB 以上及溢出"
          }
        }
      }
    },
    "1. Open itch.io's API keys page": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffne die API-Schlüssel-Seite von itch.io"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abre la página de claves API de itch.io"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. itch.io의 API 키 페이지 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abra a página de chaves de API do itch.io"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Откройте страницу API-ключей itch.io"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 打开 itch.io 的 API 密钥页面"
          }
        }
      }
    },
    "2. Sign in there if asked, tap Generate new API key, then copy the key it shows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Melde dich dort an, falls gefragt, tippe auf „Generate new API key“ und kopiere den angezeigten Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Inicia sesión allí si te lo pide, toca Generate new API key y copia la clave que aparece."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 요청하면 그곳에서 로그인하고 Generate new API key를 탭한 다음 표시되는 키를 복사합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Entre lá se for pedido, toque em Generate new API key e copie a chave mostrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Войдите там, если попросят, нажмите Generate new API key и скопируйте показанный ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 如提示登录就先登录，点“Generate new API key”，然后复制页面显示的密钥。"
          }
        }
      }
    },
    "3. Paste the key here": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Füge den Schlüssel hier ein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Pega la clave aquí"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 여기에 키 붙여넣기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cole a chave aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Вставьте ключ сюда"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 把密钥粘贴到这里"
          }
        }
      }
    },
    "30 FPS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 FPS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "30 FPS"
          }
        },
        "ko": {
          "stringUnit": {
