    "Use Epic's saves on this device? The files they replace are copied to Files › Madeira › Epic Cloud Backups first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Epics Spielstände auf diesem Gerät nutzen? Die ersetzten Dateien werden vorher nach Dateien › Madeira › Epic Cloud Backups kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usar las partidas de Epic en este dispositivo? Los archivos que reemplazan se copian antes en Archivos › Madeira › Epic Cloud Backups."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Epic의 저장 파일을 사용할까요? 대체되는 파일은 먼저 파일 › Madeira › Epic Cloud Backups에 복사됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar os saves da Epic neste dispositivo? Os arquivos que eles substituem são copiados antes para Arquivos › Madeira › Epic Cloud Backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать сохранения Epic на этом устройстве? Заменяемые файлы сначала копируются в Файлы › Madeira › Epic Cloud Backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机使用 Epic 的存档？被替换的文件会先复制到「文件 › Madeira › Epic Cloud Backups」。"
          }
        }
      }
    },
