    "JIT lets Madeira run Windows code. Choose how your %@ gets it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit JIT kann Madeira Windows-Code ausführen. Wähle, wie dein %1$@ es bekommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El JIT permite a Madeira ejecutar código de Windows. Elige cómo lo obtiene tu %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT가 있어야 Madeira가 Windows 코드를 실행할 수 있습니다. %1$@에서 JIT를 받을 방법을 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O JIT permite que o Madeira rode código do Windows. Escolha como seu %1$@ vai obtê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT позволяет Madeira выполнять код Windows. Выберите, как устройство %1$@ его получит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
