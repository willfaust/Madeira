    "Drag to send relative mouse movement for mouse-look. Tap to click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen sendet relative Mausbewegung zum Umsehen. Zum Klicken tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para enviar movimiento relativo del ratón para mirar. Toca para hacer clic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌면 시점 조작용 상대 마우스 이동을 보냅니다. 탭하면 클릭합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para enviar movimento relativo do mouse para olhar ao redor. Toque para clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивание передаёт относительное движение мыши для обзора. Нажмите, чтобы кликнуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以发送相对鼠标位移，用于第一人称视角。轻点即点击。"
          }
        }
      }
    },
