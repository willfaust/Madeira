    "Steam has not said yet whether these games have a Workshop. Pull down on the library to refresh it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam hat noch nicht mitgeteilt, ob diese Spiele einen Workshop haben. Ziehe die Bibliothek nach unten, um sie zu aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam aún no ha dicho si estos juegos tienen Workshop. Desliza hacia abajo en la biblioteca para actualizarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam이 아직 이 게임들에 창작마당이 있는지 알려 주지 않았습니다. 라이브러리를 아래로 당겨 새로 고치세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Steam ainda não informou se estes jogos têm Workshop. Puxe a biblioteca para baixo para atualizá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam пока не сообщил, есть ли у этих игр Мастерская. Потяните библиотеку вниз, чтобы обновить её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 还没说明这些游戏是否有创意工坊。请在库上下拉刷新。"
          }
        }
      }
