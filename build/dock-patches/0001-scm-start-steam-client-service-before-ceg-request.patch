     }
+    if (registered && !wide_flag(L"MADEIRA_DOCK_CEG_SERVICE_START", L'0'))
+        o->event("ceg-service-start", start_client_service(o, manager));
     CloseServiceHandle(manager);
     return sh_ceg_scm_result(true, registered);
 }
