+/* Rendering itself only needs a local timeline. Translation backends may
+ * implement ordinary fences without the cross-process sharing interfaces.
+ * Preserve real allocation/device failures; only lack of sharing permits a
+ * fallback. The caller disables external semaphore/handle support below.
+ */
+static bool
+d3d12_init_screen_fence(struct d3d12_screen *screen)
+{
+   screen->shared_fences_supported = false;
+   HRESULT hr = screen->dev->CreateFence(0, D3D12_FENCE_FLAG_SHARED,
+                                       IID_PPV_ARGS(&screen->fence));
+   if (SUCCEEDED(hr)) {
+      screen->shared_fences_supported = true;
+      return true;
+   }
+   if (hr != E_NOTIMPL && hr != DXGI_ERROR_UNSUPPORTED)
+      return false;
+
+   debug_printf("D3D12: shared fences unsupported; using a local rendering fence\n");
+   return SUCCEEDED(screen->dev->CreateFence(0, D3D12_FENCE_FLAG_NONE,
+                                            IID_PPV_ARGS(&screen->fence)));
 }
 
