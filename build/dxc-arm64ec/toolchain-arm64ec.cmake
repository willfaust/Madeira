# llvm-mingw ARM64EC cross toolchain for DXC.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
if(NOT DEFINED ENV{LLVM_MINGW})
  message(FATAL_ERROR "set LLVM_MINGW to the llvm-mingw 20260421 directory (build.sh does)")
endif()
set(LLVM_MINGW "$ENV{LLVM_MINGW}")
set(CMAKE_C_COMPILER   ${LLVM_MINGW}/bin/arm64ec-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER ${LLVM_MINGW}/bin/arm64ec-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER  ${LLVM_MINGW}/bin/arm64ec-w64-mingw32-windres)
set(CMAKE_AR           ${LLVM_MINGW}/bin/llvm-ar)
set(CMAKE_RANLIB       ${LLVM_MINGW}/bin/llvm-ranlib)
set(CMAKE_FIND_ROOT_PATH ${LLVM_MINGW}/arm64ec-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
