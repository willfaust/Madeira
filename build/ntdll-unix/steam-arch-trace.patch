+/* Read-only Steam architecture observation. No version, architecture or
+ * updater decisions are changed; no extra Windows query is issued. */
+static BOOL steam_arch_info_enabled( unsigned int slot, ULONG *saved_error )
+{
+    static LONG reports[2];
+    TEB *teb = NtCurrentTeb();
+    const UNICODE_STRING *image;
+    static const char wanted[] = "steam.exe";
+    unsigned int count, begin, i;
+    if (!teb || !teb->Peb || !teb->Peb->ProcessParameters) return FALSE;
+    image = &teb->Peb->ProcessParameters->ImagePathName;
+    if (!image->Buffer || (image->Length & 1)) return FALSE;
+    count = image->Length / sizeof(WCHAR);
+    begin = count;
+    while (begin && image->Buffer[begin - 1] != 0x5c && image->Buffer[begin - 1] != '/') --begin;
+    if (count - begin != sizeof(wanted) - 1) return FALSE;
+    for (i = 0; i < sizeof(wanted) - 1; i++)
+    {
+        WCHAR c = image->Buffer[begin + i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != wanted[i]) return FALSE;
+    }
+    if (InterlockedIncrement( &reports[slot] ) > 8) return FALSE;
+    *saved_error = teb->LastErrorValue;
+    return TRUE;
+}
+
+static void steam_arch_trace_info( const char *api, unsigned int slot, const SYSTEM_INFO *info,
+                                    NTSTATUS status, USHORT process_machine, USHORT native,
+                                    NTSTATUS machine_status, int reported_arch, const void *caller )
+{
+    ULONG error;
+    TEB *teb = NtCurrentTeb();
+    if (!steam_arch_info_enabled( slot, &error )) return;
+    ERR( "[steam-arch-v1] api=%s pid=%04lx tid=%04lx pointer-bits=%u caller=%p wow64=%u "
+         "query-status=%08lx info-valid=%u arch=%d page=%lu cpus=%lu machine-queried=%u machine-status=%08lx process-machine=%04x native-machine=%04x\n",
+         api, (ULONG)(ULONG_PTR)teb->ClientId.UniqueProcess, (ULONG)(ULONG_PTR)teb->ClientId.UniqueThread,
+         (unsigned int)(8 * sizeof(void *)), caller, !!is_wow64, status, !!info,
+         info ? info->wProcessorArchitecture : reported_arch, info ? info->dwPageSize : 0,
+         info ? info->dwNumberOfProcessors : 0, slot == 1, machine_status, process_machine, native );
+    teb->LastErrorValue = error;
+}
