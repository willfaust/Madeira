+    // Madeira: features upstream requires, optional here (build/dxvk/patches/PATCHES.md).
+    if (!m_featuresEnabled.core.features.geometryShader)
+      Logger::warn("Madeira: no geometryShader: D3D11 geometry shaders are not bound, those draws run without them");
+    if (!m_featuresEnabled.core.features.fillModeNonSolid)
