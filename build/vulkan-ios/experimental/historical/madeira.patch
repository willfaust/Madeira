+ CHECK(vkEnumerateDeviceExtensionProperties(physical,NULL,&ec,extensions));uint32_t hasSubset=0;
+ for(uint32_t i=0;i<ec;i++)if(!strcmp(extensions[i].extensionName,deviceExt))hasSubset=1;
+ free(extensions);
+ VkDeviceCreateInfo di={.sType=VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,.queueCreateInfoCount=1,.pQueueCreateInfos=&qi,.enabledExtensionCount=hasSubset,.ppEnabledExtensionNames=&deviceExt};CHECK(vkCreateDevice(physical,&di,NULL,&device));
+ VkPipelineLayoutCreateInfo li={.sType=VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};CHECK(vkCreatePipelineLayout(device,&li,NULL,&layout));
+ VkAttachmentDescription ad={.format=VK_FORMAT_R8G8B8A8_UNORM,.samples=VK_SAMPLE_COUNT_1_BIT,.loadOp=VK_ATTACHMENT_LOAD_OP_DONT_CARE,.storeOp=VK_ATTACHMENT_STORE_OP_DONT_CARE,.initialLayout=VK_IMAGE_LAYOUT_UNDEFINED,.finalLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+ VkAttachmentReference ref={0,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};VkSubpassDescription sub={.pipelineBindPoint=VK_PIPELINE_BIND_POINT_GRAPHICS,.colorAttachmentCount=1,.pColorAttachments=&ref};
+ VkRenderPassCreateInfo ri={.sType=VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,.attachmentCount=1,.pAttachments=&ad,.subpassCount=1,.pSubpasses=&sub};CHECK(vkCreateRenderPass(device,&ri,NULL,&pass));
+ VkShaderModuleCreateInfo si={.sType=VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,.codeSize=sizeof(vs),.pCode=vs};CHECK(vkCreateShaderModule(device,&si,NULL,&shader));
+ VkPipelineCacheCreateInfo ci={.sType=VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};VkPipelineCache clean,bad,empty;CHECK(vkCreatePipelineCache(device,&ci,NULL,&clean));CHECK(vkCreatePipelineCache(device,&ci,NULL,&bad));CHECK(vkCreatePipelineCache(device,&ci,NULL,&empty));
+ VkResult control=attempt(clean,3,1,"CONTROL fresh-cache valid");
+ size_t before=0,afterSize=0;CHECK(vkGetPipelineCacheData(device,clean,&before,NULL));
+ VkResult unused=attempt(clean,3,2,"REGRESSION valid plus unused location 0");
+ CHECK(vkGetPipelineCacheData(device,clean,&afterSize,NULL));
+ printf("[vk-vertex-reuse] before=%zu after=%zu unused-result=%d\n",before,afterSize,unused);
+ int reused=unused==VK_SUCCESS && before==afterSize;
+
+ attempt(bad,0,1,"PRIME mismatched-layout");VkResult after=attempt(bad,3,1,"REGRESSION same-cache valid");
+ attempt(empty,0,0,"PRIME empty-layout");VkResult afterEmpty=attempt(empty,3,1,"REGRESSION same-cache valid after empty");
+ vkDestroyPipelineCache(device,clean,NULL);vkDestroyPipelineCache(device,bad,NULL);vkDestroyPipelineCache(device,empty,NULL);
+ vkDestroyShaderModule(device,shader,NULL);vkDestroyRenderPass(device,pass,NULL);vkDestroyPipelineLayout(device,layout,NULL);vkDestroyDevice(device,NULL);vkDestroyInstance(instance,NULL);
+ printf("[vk-vertex-cache-test] %s control=%d after-mismatch=%d after-empty=%d\n",control==VK_SUCCESS && after==VK_SUCCESS && afterEmpty==VK_SUCCESS ? "PASS" : "FAIL",control,after,afterEmpty);
+ printf("[vk-vertex-reuse-test] %s cache-before=%zu cache-after=%zu\n",control==VK_SUCCESS && after==VK_SUCCESS && afterEmpty==VK_SUCCESS && reused ? "PASS" : "FAIL",before,afterSize);
+ return control!=VK_SUCCESS || after!=VK_SUCCESS || afterEmpty!=VK_SUCCESS || !reused;
+}
diff --git a/tests/vulkan/vertex-converter-probe.cpp b/tests/vulkan/vertex-converter-probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..74d63de60df0c71ddfaa5455c6a2d141a842b0cd
--- /dev/null
+++ b/tests/vulkan/vertex-converter-probe.cpp
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+#include "SPIRVToMSLConverter.h"
+#include <cassert>
+#include <cstdio>
+using namespace mvk;
+static const uint32_t vs[]={0x07230203,0x00010000,0,13,0,
+ (2<<16)|17,1, (3<<16)|14,0,1,
+ (7<<16)|15,0,10,0x6e69616d,0,7,8,
+ (4<<16)|71,7,30,3, (4<<16)|71,8,11,0,
+ (2<<16)|19,1, (3<<16)|22,2,32, (4<<16)|23,3,2,4,
+ (4<<16)|32,4,1,3, (4<<16)|32,5,3,3, (3<<16)|33,6,1,
+ (4<<16)|59,4,7,1, (4<<16)|59,5,8,3,
+ (5<<16)|54,1,10,0,6, (2<<16)|248,11,
+ (4<<16)|61,3,12,7, (3<<16)|62,8,12, (1<<16)|253, (1<<16)|56};
+
+static SPIRVToMSLConversionConfiguration config(unsigned location){
+ SPIRVToMSLConversionConfiguration c;c.options.entryPointStage=spv::ExecutionModelVertex;c.options.entryPointName="main";
+ MSLShaderInterfaceVariable si;si.shaderVar.location=location;si.binding=0;c.shaderInputs.push_back(si);return c;
+}
+static void convert(SPIRVToMSLConversionConfiguration& c){
+ SPIRVToMSLConverter compiler;compiler.setSPIRV(vs,sizeof(vs)/sizeof(*vs));SPIRVToMSLConversionResult result;
+ bool ok=compiler.convert(c,result);if(!ok)std::puts(result.resultLog.c_str());assert(ok);
+}
+int main(){
+ auto good=config(3);assert(!good.vertexInputsFullyCovered);convert(good);assert(good.vertexInputsFullyCovered);
+ auto unused=config(3);MSLShaderInterfaceVariable si;si.shaderVar.location=0;si.binding=0;unused.shaderInputs.push_back(si);
+ assert(good.matches(unused)); // ignored input must not recompile the MSL
+ auto requiredMissing=config(0);assert(!good.matches(requiredMissing));convert(requiredMissing);assert(!requiredMissing.vertexInputsFullyCovered);assert(!requiredMissing.matches(good));
+ auto empty=config(0);empty.shaderInputs.clear();convert(empty);assert(!empty.vertexInputsFullyCovered);assert(!empty.matches(good));
+ auto differentFormat=config(3);differentFormat.shaderInputs[0].shaderVar.format=SPIRV_CROSS_NAMESPACE::MSL_SHADER_VARIABLE_FORMAT_UINT8;assert(!good.matches(differentFormat));
+ auto loaded=good;loaded.vertexInputsFullyCovered=false;assert(!loaded.matches(unused));assert(loaded.matches(config(3)));
+ std::puts("PASS: actual converter reflection and matching: covered, unused, missing, empty, format, conservative loaded hint");
+}
diff --git a/tests/x64/fixed-reserve.c b/tests/x64/fixed-reserve.c
new file mode 100644
index 0000000000000000000000000000000000000000..ee3646ff0febcba5d20af69b3b141d5742974af5
--- /dev/null
+++ b/tests/x64/fixed-reserve.c
@@ -0,0 +1,102 @@
+/* Fixed-address VirtualAlloc contract regression; no game-specific inputs.
+ * Run in a fresh Madeira session. Reserves VA, commits only 64 KiB explicitly.
+ * Build with llvm-mingw x86_64-w64-mingw32-clang -O2 fixed-reserve.c -o fixed-reserve.exe
+ */
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+
+static unsigned failed, skipped;
+
+static void conflict(void *arena, SIZE_T size, DWORD type)
+{
+    void *result = VirtualAlloc(arena, size, type, PAGE_READWRITE);
+    if (result)
+    {
+        printf("FAIL: occupied fixed request %p size=%llx type=%lx returned %p\n",
+               arena, (unsigned long long)size, (unsigned long)type, result);
+        failed++;
+        if (result != arena) VirtualFree(result, 0, MEM_RELEASE);
+    }
+    else printf("PASS: occupied fixed request rejected size=%llx type=%lx error=%lu\n",
+                (unsigned long long)size, (unsigned long)type, GetLastError());
+}
+
+int main(void)
+{
+    const SIZE_T gib = (SIZE_T)1 << 30;
+    void *arena = VirtualAlloc(NULL, gib + 0x10000, MEM_RESERVE, PAGE_READWRITE);
+    if (!arena)
+    {
+        printf("INCOMPLETE: no room for test arena, error=%lu\n", GetLastError());
+        return 2;
+    }
+    void *page = VirtualAlloc(arena, 0x10000, MEM_COMMIT, PAGE_READWRITE);
+    if (page != arena)
+    {
+        printf("FAIL: commit inside automatic reservation returned %p\n", page);
+        VirtualFree(arena, 0, MEM_RELEASE);
+        return 1;
+    }
+    *(volatile DWORD *)page = 0x1234abcd;
+    conflict(arena, 0x10000, MEM_RESERVE);
+    conflict(arena, gib, MEM_RESERVE);
+    conflict(arena, gib + 0x10000, MEM_RESERVE);
+    conflict(arena, gib, MEM_RESERVE | MEM_COMMIT);
+    if (*(volatile DWORD *)page != 0x1234abcd)
+    {
+        puts("FAIL: conflicting request changed the original mapping");
+        failed++;
+    }
+    else puts("PASS: original committed data preserved");
+    if (!VirtualFree(arena, 0, MEM_RELEASE))
+    {
+        puts("FAIL: original reservation release failed");
+        failed++;
+    }
+
+    /* A caller that needs an aligned arena can select its own next address.
+     * Do not assume the device has the VA capacity to grant one. */
+    SYSTEM_INFO info;
+    GetSystemInfo(&info);
+    uintptr_t first = ((uintptr_t)info.lpMinimumApplicationAddress + gib - 1) & ~(gib - 1);
+    uintptr_t high = (uintptr_t)info.lpMaximumApplicationAddress;
+    arena = NULL;
+    for (uintptr_t addr = first; addr <= high && high - addr >= gib - 1; addr += gib)
+    {
+        void *result = VirtualAlloc((void *)addr, gib, MEM_RESERVE, PAGE_READWRITE);
+        if (!result) continue;
+        if (result != (void *)addr)
+        {
+            printf("FAIL: aligned fixed request %p redirected to %p\n", (void *)addr, result);
+            failed++;
+            VirtualFree(result, 0, MEM_RELEASE);
+            break;
+        }
+        arena = result;
+        break;
+    }
+    if (arena)
+    {
+        page = VirtualAlloc((char *)arena + 0x20000, 0x10000, MEM_COMMIT, PAGE_READWRITE);
+        if (page != (char *)arena + 0x20000)
+        {
+            puts("FAIL: commit inside aligned arena failed");
+            failed++;
+        }
+        else
+        {
+            *(volatile DWORD *)page = 0x4567cdef;
+            if (*(volatile DWORD *)page != 0x4567cdef) failed++;
+            else puts("PASS: caller-selected aligned arena supports commit/read/write");
+        }
+        if (!VirtualFree(arena, 0, MEM_RELEASE)) failed++;
+    }
+    else
+    {
+        puts("SKIP: no aligned arena granted (or redirect already reported)");
+        skipped++;
+    }
+    printf("SUMMARY: failed=%u skipped=%u\n", failed, skipped);
+    return failed ? 1 : skipped ? 2 : 0;
+}
