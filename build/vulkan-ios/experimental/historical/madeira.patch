diff --git a/build/experimental/apply-wine-overlay.sh b/build/experimental/apply-wine-overlay.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8eadbb33a9bffc23084ac55f3b2639d7e39af721
--- /dev/null
+++ b/build/experimental/apply-wine-overlay.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+# Local LGPL Wine diagnostics; no changes to the pinned FEX checkout.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+PATCH="$ROOT/build/experimental/wine-vulkan-diagnostics.patch"
+EXPECTED=9129e9684daaeae70da9435e7c6060e59392634e
+test "$(git -C "$ROOT/wine" rev-parse HEAD)" = "$EXPECTED" || {
+    echo "Wine must be at the superproject pin $EXPECTED" >&2; exit 1;
+}
+if git -C "$ROOT/wine" apply --reverse --check "$PATCH" 2>/dev/null; then
+    echo "Wine experimental overlay already applied."
+else
+    git -C "$ROOT/wine" apply --check "$PATCH"
+    git -C "$ROOT/wine" apply "$PATCH"
+    echo "Wine experimental overlay applied."
+fi
