new file mode 100644
index 0000000000000000000000000000000000000000..0c4b7a94a3520c82613886dbb37f95ee4bc4404b
--- /dev/null
+++ b/tests/host/check-wait-state-diagnostics.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Catch unsafe reads, missing resource bytes, duplicate floods, or unbounded capture.
+Uses actual Darwin VM reads including a PROT_NONE page, and the production sampler.
+"""
+from pathlib import Path
+import subprocess, tempfile
+root=Path(__file__).resolve().parents[2]
+header=root/'build/ntdll-unix/ios_wait_state_diag.h'
+assert header.exists(), 'Missing bounded read-only wait-state sampler: blocked-thread resource bytes cannot be captured'
+source=r'''
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <assert.h>
+#include "ios_wait_state_diag.h"
+static int read_vm(void *unused, uint64_t address, void *out, size_t size) {
+ mach_vm_size_t got=0; (void)unused;
+ return mach_vm_read_overwrite(mach_task_self(),address,size,(mach_vm_address_t)out,&got)==KERN_SUCCESS && got==size;
+}
+int main(void) {
+ struct mw_diag state={0}; struct mw_input input={0}; struct mw_capture capture;
+ size_t page=(size_t)sysconf(_SC_PAGESIZE);
+ unsigned char *object=mmap(NULL,page,PROT_READ|PROT_WRITE,MAP_ANON|MAP_PRIVATE,-1,0);
+ unsigned char *guard=mmap(NULL,page,PROT_NONE,MAP_ANON|MAP_PRIVATE,-1,0);
+ assert(object!=MAP_FAILED && guard!=MAP_FAILED);
+ uint64_t table[32]={0}; table[7]=0x123456789;
+ memcpy(object,&(uint64_t){(uint64_t)table},8); object[42]=1;
+ input.key=0x10000; input.tid=0x110; input.pc=0x40000; input.sp=(uint64_t)guard;
+ input.regs[0]=(uint64_t)object; input.regs[1]=(uint64_t)guard;
+ assert(!mw_observe(&state,&input,0,read_vm,NULL,&capture));
+ assert(!mw_observe(&state,&input,20,read_vm,NULL,&capture));
+ assert(mw_observe(&state,&input,40,read_vm,NULL,&capture));
+ assert(capture.memory[0].valid && capture.memory[0].bytes[42]==1);
+ assert(capture.memory[0].indirect_valid && capture.memory[0].indirect[7]==0x123456789);
+ assert(!capture.memory[1].valid && !capture.stack_valid);
+ assert(!mw_observe(&state,&input,200,read_vm,NULL,&capture));
+ object[42]=0;
+ assert(mw_observe(&state,&input,340,read_vm,NULL,&capture));
+ assert(capture.memory[0].bytes[42]==0);
+ assert(!mw_observe(&state,&input,480,read_vm,NULL,&capture));
+ /* A different saved PC is a new streak; never attach old stability to it. */
+ input.pc++;
+ assert(!mw_observe(&state,&input,500,read_vm,NULL,&capture));
+ assert(!mw_observe(&state,&input,520,read_vm,NULL,&capture));
+ assert(mw_observe(&state,&input,540,read_vm,NULL,&capture));
+ for(unsigned n=0;n<10000;n++) { object[42]=(unsigned char)n; mw_observe(&state,&input,600+n*121,read_vm,NULL,&capture); }
+ assert(state.emitted<=MW_TOTAL_LIMIT && state.slots[0].emitted<=MW_THREAD_LIMIT);
+ /* Many distinct blocked threads must still respect the process-wide cap. */
+ struct mw_diag global_state={0};
+ for(unsigned tid=1;tid<=128;tid++) {
+  input.tid=tid;
+  mw_observe(&global_state,&input,0,read_vm,NULL,&capture);
+  mw_observe(&global_state,&input,20,read_vm,NULL,&capture);
+  for(unsigned n=0;n<40;n++) {
+   object[42]=(unsigned char)n;
+   mw_observe(&global_state,&input,40+n*121,read_vm,NULL,&capture);
+  }
+ }
+ assert(global_state.emitted==MW_TOTAL_LIMIT);
+ object[42]=(unsigned char)9999; input.tid=0x110;
+ /* Capture is read-only even when the source page is protected. */
+ assert(mprotect(object,page,PROT_READ)==0);
+ struct mw_diag readonly_state={0};
+ mw_observe(&readonly_state,&input,0,read_vm,NULL,&capture);
+ mw_observe(&readonly_state,&input,20,read_vm,NULL,&capture);
+ assert(mw_observe(&readonly_state,&input,40,read_vm,NULL,&capture));
+ assert(object[42]==(unsigned char)9999);
+ FILE *log=tmpfile(); assert(log); mw_print(log,&input,&capture);
+ fflush(log); rewind(log); char line[2048]; assert(fgets(line,sizeof(line),log));
+ assert(strstr(line,"last-x64-exit") && strstr(line,"not-atomic") && strstr(line,"tid=0110"));
+ fclose(log);
+ /* Even a fully readable capture with maximal-width addresses is <24 KiB. */
+ memset(&capture,0xff,sizeof(capture));
+ memset(&input,0xff,sizeof(input));
+ log=tmpfile(); assert(log); mw_print(log,&input,&capture); fflush(log);
+ assert(ftell(log)<24*1024); fclose(log);
+ munmap(object,page); munmap(guard,page);
+ puts("PASS: real VM reads, inaccessible pointers, object flag transition, indirect table, stability, dedup, read-only and capture limits");
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+ c=Path(tmp)/'test.c'; exe=Path(tmp)/'test'; c.write_text(source)
+ subprocess.run(['xcrun','clang','-std=c11','-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-I'+str(header.parent),str(c),'-o',str(exe)],check=True)
+ subprocess.run([str(exe)],check=True)
