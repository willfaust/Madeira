++/* Opt-in boundary evidence only; no Vulkan arguments/results are modified. */
++static int wine_vk_vertex_read(void *to,const void *from,size_t size)
++{
++    SIZE_T copied=0;
++    return ReadProcessMemory(GetCurrentProcess(),from,to,size,&copied) && copied==size;
++}
++struct madeira_vertex_stamp wine_vk_vertex_capture(uint32_t count,const VkGraphicsPipelineCreateInfo *infos)
++{
++    char enabled[8];
++    DWORD saved_error=GetLastError();
++    struct madeira_vertex_stamp stamp={0,0};
++    if(GetEnvironmentVariableA("MADEIRA_VK_PIPELINE_DIAGNOSTICS",enabled,sizeof(enabled))==1 && enabled[0]=='1')
++        stamp=madeira_stamp(count,infos,wine_vk_vertex_read);
++    SetLastError(saved_error);
++    return stamp;
++}
++void wine_vk_vertex_report(struct madeira_vertex_stamp stamp,const VkGraphicsPipelineCreateInfo *infos,uint32_t count,VkResult result)
++{
++    static LONG failures;
++    if(stamp.hash && result<0 && InterlockedIncrement(&failures)<=32)
++    {
++        DWORD saved_error=GetLastError();
++        TRACE("[vk-boundary] PE-entry infos=%p count=%u vertex_hash=%08x%08x complete=%d result=%d\n",
++              infos,count,(unsigned)(stamp.hash>>32),(unsigned)stamp.hash,stamp.complete,result);
++        SetLastError(saved_error);
++    }
++}
