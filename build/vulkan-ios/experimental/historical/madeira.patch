++/* Copyright (c) 2026 Madeira contributors. SPDX-License-Identifier: Apache-2.0
++ * Opt-in, bounded observations of actual Metal library compile inputs.
++ * No source, options, return values, or compiler scheduling are changed.
++ */
++#pragma once
++#include <CommonCrypto/CommonDigest.h>
++#include <array>
++#include <algorithm>
++#include <cstdint>
++#include <chrono>
++#include <cstdio>
++#include <cstdlib>
++#include <cstring>
++#include <mutex>
