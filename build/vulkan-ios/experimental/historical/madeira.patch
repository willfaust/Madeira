++/* Bounded, read-only pipeline input fingerprint shared by PE and Unix diagnostics.
++ * A matching hash is evidence about these fields, not proof of shader correctness.
++ * No pointer values/padding hashed. SPDX-License-Identifier: LGPL-2.1-or-later */
++#ifndef MADEIRA_VERTEX_STAMP_H
++#define MADEIRA_VERTEX_STAMP_H
++#include <stdint.h>
++#include <stddef.h>
++struct madeira_vertex_stamp { uint64_t hash; int complete; };
++static inline void madeira_stamp_word(struct madeira_vertex_stamp *s,uint32_t value)
++{
++    for(unsigned i=0;i<4;i++){s->hash^=(value>>(i*8))&255;s->hash*=UINT64_C(1099511628211);}
++}
++static inline struct madeira_vertex_stamp madeira_stamp(uint32_t count,
++        const VkGraphicsPipelineCreateInfo *infos,int (*read)(void *,const void *,size_t))
++{
++    struct madeira_vertex_stamp s={UINT64_C(14695981039346656037),0};
++    if(count>8 || (count&&!infos))return s;
++    madeira_stamp_word(&s,count);
++    for(uint32_t n=0;n<count;n++){
++        VkGraphicsPipelineCreateInfo p;VkPipelineVertexInputStateCreateInfo v;
++        if(!read(&p,&infos[n],sizeof(p)) || p.pNext)return s;
++        madeira_stamp_word(&s,p.flags);
++        madeira_stamp_word(&s,p.pVertexInputState!=NULL);
++        if(!p.pVertexInputState)continue;
++        if(!read(&v,p.pVertexInputState,sizeof(v)) || v.pNext ||
++           v.vertexBindingDescriptionCount>256 || v.vertexAttributeDescriptionCount>256)return s;
++        madeira_stamp_word(&s,v.flags);
++        madeira_stamp_word(&s,v.vertexBindingDescriptionCount);
++        madeira_stamp_word(&s,v.vertexAttributeDescriptionCount);
++        for(uint32_t i=0;i<v.vertexBindingDescriptionCount;i++){
++            VkVertexInputBindingDescription b;
++            if(!v.pVertexBindingDescriptions || !read(&b,&v.pVertexBindingDescriptions[i],sizeof(b)))return s;
++            madeira_stamp_word(&s,b.binding);madeira_stamp_word(&s,b.stride);madeira_stamp_word(&s,b.inputRate);
++        }
++        for(uint32_t i=0;i<v.vertexAttributeDescriptionCount;i++){
++            VkVertexInputAttributeDescription a;
++            if(!v.pVertexAttributeDescriptions || !read(&a,&v.pVertexAttributeDescriptions[i],sizeof(a)))return s;
++            madeira_stamp_word(&s,a.location);madeira_stamp_word(&s,a.binding);
++            madeira_stamp_word(&s,a.format);madeira_stamp_word(&s,a.offset);
++        }
++    }
++    s.complete=1;return s;
++}
++#endif
