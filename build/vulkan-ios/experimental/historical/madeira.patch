+@@ -380,6 +380,7 @@ VkResult WINAPI vkCreateInstance(const VkInstanceCreateInfo *create_info,
+ 
+     TRACE("create_info %p, allocator %p, instance %p\n", create_info, allocator, ret);
+ 
++    ERR("[vk-pe] WineVulkan vkCreateInstance -> Unix\n");
+     if (!wine_vk_init_once())
+         return VK_ERROR_INITIALIZATION_FAILED;
+ 
+@@ -429,6 +430,7 @@ VkResult WINAPI vkCreateInstance(const VkInstanceCreateInfo *create_info,
+         free(instance);
+         *ret = NULL;
