+#!/usr/bin/env python3
+"""Real exit-state C and actual Swift launch/poll branches: a completed short
+program must finish without the generic launch error; a never-started session
+still fails. The external UI services are fixtures, not a GPU/device test.
+"""
+from pathlib import Path
+import subprocess,tempfile
+root=Path(__file__).resolve().parents[2]
+bridge=(root/'app/Madeira/WineProcessBridge.m').read_text()
+lib=(root/'app/Madeira/Library.swift').read_text()
+def block(text,head):
+ start=text.index(head);a=text.index('{',start);n=1;b=a+1
+ while n:
+  n+=(text[b]=='{')-(text[b]=='}');b+=1
+ return text[start:b]
+c='#include <stdint.h>\n'+bridge[bridge.index('static uint64_t g_launch_exit'):bridge.index('static char *g_prefix_path')]
+# Absent function is a failing behavior, rather than a harness compiler error.
+if 'int wine_launched_process_has_exited(' not in bridge:
+ c+='\nint wine_launched_process_has_exited(void) { return 0; }\n'
+swift=r'''
+import Foundation
+@_silgen_name("wine_launched_process_did_exit") func exited(_ status: Int32)
+@_silgen_name("wine_launched_process_has_exited") func wine_launched_process_has_exited() -> Int32
+@_silgen_name("wine_crash_exit_status") func crashStatus(_ status: UnsafeMutablePointer<UInt32>?) -> Int32
+@_silgen_name("wine_exit_status_reset") func reset()
+var running: Int32 = 0
+var server: Int32 = 0
+func wine_process_is_running() -> Int32 { running }
+func wineserver_is_running() -> Int32 { server }
+func madeira_get_present_count() -> UInt64 { 0 }
+func winios_surface_present_count() -> UInt64 { 0 }
+class DockStartScreen {
+ static let shared = DockStartScreen()
+ var active = false; var holding = false
+ func poll(_ model: Harness, rendered: Bool) {}
+}
+class MetalBackedView {
+ static let presentCountAtLaunch: UInt64 = 0
+ static func refreshDisplayMode(reason: String) {}
+}
+class Harness {
+ var current: Int? = 1
+ var sawProcess = false
+ var error: String?; var jitNotice: String?
+ var launching = false; var launchSlow = false
+ var launchStarted = Date(); var launchPresent: UInt64 = 0; var launchSurface: UInt64 = 0
+ var sessionMessage = "Starting…"; var laidOutAfterFirstPresent = true
+ var finished = false
+ // The UI cleanup is external to the launch-classification branch under test.
+ func finish() { finished = true; current = nil }
+ func showGameView(reason: String) {}
+'''+block(lib,'private func poll()').replace('private func','func',1)+'\n'+block(lib,'func launchFailed(')+r'''
+}
+var failures = 0
+func expect(_ value: Bool, _ label: String) { print("\(value ? "PASS" : "FAIL"): \(label)");if !value {failures += 1} }
+reset()
+expect(wine_launched_process_has_exited()==0, "new session has no completion")
+let never = Harness(); never.launchFailed()
+expect(never.finished && never.error != nil, "never started still reports failure")
+reset(); exited(0)
+expect(wine_launched_process_has_exited() != 0, "normal exit is latched even between polls")
+expect(crashStatus(nil)==0, "normal completion is not a crash")
+let fast = Harness();fast.launchFailed()
+expect(fast.finished && fast.error == nil && fast.sawProcess, "fast clean completion avoids false launch alert")
+let pollFast = Harness();pollFast.poll()
+expect(pollFast.finished && pollFast.sawProcess, "poll ends an already completed short session")
+server = 1
+let cleanup = Harness();cleanup.poll()
+expect(!cleanup.finished, "poll waits for server cleanup")
+server = 0;cleanup.poll();expect(cleanup.finished, "poll finishes after cleanup")
+reset();exited(Int32(bitPattern: 0xc0000005))
+var code: UInt32 = 0
+expect(wine_launched_process_has_exited() != 0 && crashStatus(&code) != 0 && code == 0xc0000005, "fast crash retains its real NTSTATUS")
+let crash = Harness();crash.launchFailed()
+expect(crash.finished && crash.sawProcess && crash.error == nil, "fast crash reaches finish with exit-report eligibility and no generic overwrite")
+exited(0)
+expect(crashStatus(&code) != 0 && code == 0xc0000005, "later normal callback cannot erase recorded crash")
+reset();expect(wine_launched_process_has_exited()==0 && crashStatus(nil)==0, "next session clears completion and crash")
+let jit = Harness();jit.launchFailed("Enable JIT", offerJIT:true)
+expect(jit.jitNotice=="Enable JIT" && jit.error==nil, "real JIT failure still offers JIT")
+running=1
+let active = Harness();active.poll();active.launchFailed()
+expect(active.sawProcess && !active.finished && active.error==nil, "running session is not ended by late failure check")
+exit(failures == 0 ? 0 : 1)
+'''
+with tempfile.TemporaryDirectory() as t:
+ p=Path(t);(p/'exit.c').write_text(c);(p/'main.swift').write_text(swift)
+ subprocess.run(['cc','-std=c11','-Wall','-Werror','-c',str(p/'exit.c'),'-o',str(p/'exit.o')],check=True)
+ subprocess.run(['swiftc',str(p/'main.swift'),str(p/'exit.o'),'-o',str(p/'test')],check=True)
+ subprocess.run([str(p/'test')],check=True)
