@@ -0,0 +1,47 @@
+#!/bin/bash
+# Pinned upstream MoltenVK plus verified local compatibility/diagnostic patches.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+HERE="$ROOT/build/vulkan-ios"
+REV=db66022459ffb663aa2b50f6b018bc2e124f5edf
+SRC="${MADEIRA_MOLTENVK_SOURCE:-$ROOT/toolchains/moltenvk-source}"
+PATCHES=("$HERE/patches/0001-isolate-vertex-input-cache.patch"
+         "$HERE/patches/0002-warn-only-if-integer-blending-enabled.patch"
+         "$HERE/patches/0003-size-cache-before-direct-export.patch"
+         "$HERE/patches/0004-bound-pipeline-shader-cache.patch"
+         "$HERE/patches/0005-account-for-nonserialized-cache-hint.patch"
+         "$HERE/patches/0006-own-merged-specialization-libraries.patch"
+         "$HERE/patches/0007-observe-metal-library-compile-inputs.patch"
+         "$HERE/patches/0008-zero-unbound-vertex-inputs-opt-in.patch"
+         "$HERE/patches/0009-select-metal-library-optimization.patch"
+         "$HERE/patches/0010-integer-fragment-output-compatibility.patch")
+if [ ! -d "$SRC" ]; then
+    git clone --depth 1 --branch v1.4.2 https://github.com/KhronosGroup/MoltenVK.git "$SRC"
+fi
+[ "$(git -C "$SRC" rev-parse HEAD)" = "$REV" ] || {
+    echo "MoltenVK source must be at $REV: $SRC" >&2; exit 1;
+}
+for PATCH in "${PATCHES[@]}"; do
+if git -C "$SRC" apply --reverse --check "$PATCH" 2>/dev/null; then
+    echo "Patch already applied: $PATCH"
+else
+    git -C "$SRC" apply --check "$PATCH"
+    git -C "$SRC" apply "$PATCH"
+fi
+done
+cd "$SRC"
+./fetchDependencies --ios --keep-cache
+# PRELINK_LIBS can retain a stale converter in an incremental parent archive.
+# A clean build guarantees that the selected source patch is actually linked.
+xcodebuild clean build -project MoltenVKPackaging.xcodeproj \
+    -scheme 'MoltenVK Package (iOS only)' -configuration Release \
+    -destination 'generic/platform=iOS' -jobs 2 \
+    CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=
+LIB="$SRC/Package/Release/MoltenVK/static/MoltenVK.xcframework/ios-arm64/libMoltenVK.a"
+[ -f "$LIB" ] || { echo "Missing source-built MoltenVK archive: $LIB" >&2; exit 1; }
+DEST="$ROOT/toolchains/moltenvk-patched/ios-arm64"
+mkdir -p "$DEST"
+cp "$LIB" "$DEST/libMoltenVK.a"
+git rev-parse HEAD > "$DEST/source-revision.txt"
+shasum -a 256 "${PATCHES[@]}" "$DEST/libMoltenVK.a" > "$DEST/SHA256SUMS"
+echo "Built pinned MoltenVK with verified local patches: $DEST"
