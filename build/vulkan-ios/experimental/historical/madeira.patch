diff --git a/build/ntdll-unix/ios_wait_state_diag.h b/build/ntdll-unix/ios_wait_state_diag.h
new file mode 100644
index 0000000000000000000000000000000000000000..6328e4944fac805ae65e727151deafd996ccaffc
--- /dev/null
+++ b/build/ntdll-unix/ios_wait_state_diag.h
@@ -0,0 +1,87 @@
+/* Read-only last-x64-exit snapshots for persistent guest waits.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * No PE/FEX calls, thread suspension, target writes or game-specific addresses.
+ */
+#ifndef MADEIRA_WAIT_STATE_DIAG_H
+#define MADEIRA_WAIT_STATE_DIAG_H
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stddef.h>
+
+enum { MW_SLOTS=128, MW_REGS=15, MW_BYTES=256, MW_THREAD_LIMIT=32, MW_TOTAL_LIMIT=2048 };
+struct mw_input { uint64_t key, tid, pc, sp, regs[MW_REGS]; };
+struct mw_memory { unsigned valid, indirect_valid; unsigned char bytes[MW_BYTES]; uint64_t indirect[16]; };
+struct mw_capture { struct mw_memory memory[MW_REGS]; unsigned stack_valid; unsigned char stack[MW_BYTES]; };
+struct mw_slot { uint64_t key, tid, pc, sp, hash, last; unsigned hits, emitted; };
+struct mw_diag { struct mw_slot slots[MW_SLOTS]; unsigned emitted; };
+typedef int (*mw_reader)(void *, uint64_t, void *, size_t);
+
+/* Called by one sampler at a time. A caller must serialize concurrent observers. */
+static int mw_observe(struct mw_diag *state, const struct mw_input *input, uint64_t now,
+                     mw_reader read_memory, void *opaque, struct mw_capture *capture)
+{
+    struct mw_slot *slot=NULL;
+    uint64_t hash=14695981039346656037ull;
+    unsigned i; size_t j;
+    if (!input->key || !input->pc || !input->sp || state->emitted>=MW_TOTAL_LIMIT) return 0;
+    for (i=0;i<MW_SLOTS;i++) {
+        if (state->slots[i].key==input->key && state->slots[i].tid==input->tid) { slot=&state->slots[i]; break; }
+        if (!slot && !state->slots[i].key) slot=&state->slots[i];
+    }
+    if (!slot || slot->emitted>=MW_THREAD_LIMIT) return 0;
+    if (slot->key!=input->key || slot->tid!=input->tid || slot->pc!=input->pc || slot->sp!=input->sp) {
+        /* Preserve the slot's budget across changes of PC or reuse of its TEB. */
+        slot->key=input->key; slot->tid=input->tid; slot->pc=input->pc; slot->sp=input->sp;
+        slot->hits=1; slot->hash=0; slot->last=0;
+        return 0;
+    }
+    if (slot->hits<3) slot->hits++;
+    if (slot->hits<3 || (slot->last && now-slot->last<120)) return 0;
+    memset(capture,0,sizeof(*capture));
+    for (i=0;i<MW_REGS;i++) {
+        uint64_t indirect=0;
+        if (input->regs[i]<0x10000 || input->regs[i]>UINT64_MAX-MW_BYTES) continue;
+        capture->memory[i].valid=read_memory(opaque,input->regs[i],capture->memory[i].bytes,MW_BYTES);
+        if (capture->memory[i].valid) {
+            memcpy(&indirect,capture->memory[i].bytes,sizeof(indirect));
+            if (indirect>=0x10000 && indirect<=UINT64_MAX-sizeof(capture->memory[i].indirect))
+                capture->memory[i].indirect_valid=read_memory(opaque,indirect,capture->memory[i].indirect,sizeof(capture->memory[i].indirect));
+        }
+    }
+    if (input->sp>=0x10000 && input->sp<=UINT64_MAX-MW_BYTES)
+        capture->stack_valid=read_memory(opaque,input->sp,capture->stack,MW_BYTES);
+    /* Whole capture is initialized, including padding; hash is dedup only. */
+    for (j=0;j<sizeof(*capture);j++) hash=(hash^((const unsigned char *)capture)[j])*1099511628211ull;
+    for (j=0;j<sizeof(input->regs);j++) hash=(hash^((const unsigned char *)input->regs)[j])*1099511628211ull;
+    slot->last=now;
+    if (slot->hash==hash) return 0;
+    slot->hash=hash; slot->emitted++; state->emitted++;
+    return 1;
+}
+
+static void mw_print_bytes(FILE *out, const char *kind, unsigned index, const unsigned char *bytes, size_t size)
+{
+    size_t off, j;
+    for (off=0;off<size;off+=32) {
+        fprintf(out,"[wait-state] %s[%u]+%03zx:",kind,index,off);
+        for (j=off;j<off+32 && j<size;j++) fprintf(out,"%02x",bytes[j]);
+        fputc('\n',out);
+    }
+}
+static void mw_print(FILE *out, const struct mw_input *input, const struct mw_capture *capture)
+{
+    static const char *names[MW_REGS]={"rbx","rsi","rdi","r12","r13","r14","r15","rbp","rcx","rdx","r8","r9","rax","r10","r11"};
+    unsigned i;
+    fprintf(out,"[wait-state] last-x64-exit not-current-PC not-atomic tid=%04llx teb=%llx rip=%llx rsp=%llx\n",
+            (unsigned long long)input->tid,(unsigned long long)input->key,
+            (unsigned long long)input->pc,(unsigned long long)input->sp);
+    for(i=0;i<MW_REGS;i++) {
+        fprintf(out,"[wait-state] %s[%u]=%llx readable=%u indirect-readable=%u\n",names[i],i,
+                (unsigned long long)input->regs[i],capture->memory[i].valid,capture->memory[i].indirect_valid);
+        if(capture->memory[i].valid) mw_print_bytes(out,"object",i,capture->memory[i].bytes,MW_BYTES);
+        if(capture->memory[i].indirect_valid) mw_print_bytes(out,"indirect",i,(const unsigned char *)capture->memory[i].indirect,sizeof(capture->memory[i].indirect));
+    }
+    if(capture->stack_valid) mw_print_bytes(out,"stack",0,capture->stack,MW_BYTES);
+}
+#endif
