+++ b/build/vulkan-ios/build.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+# Build the native Vulkan backend and Wine Unix thunk table, then merge MoltenVK.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+HERE="$ROOT/build/vulkan-ios"
+MVK="$ROOT/toolchains/moltenvk/MoltenVK"
+OBJ="$HERE/obj"
+PATCHED="$ROOT/toolchains/moltenvk-patched/ios-arm64"
+LIB="$PATCHED/libMoltenVK.a"
+[ -f "$LIB" ] || { echo "Missing source-built MoltenVK: run build/vulkan-ios/build-moltenvk-source.sh" >&2; exit 1; }
+[ -f "$MVK/include/vulkan/vulkan.h" ] || { echo "Missing pinned Vulkan headers: run build/vulkan-ios/fetch.sh" >&2; exit 1; }
+[ "$(cat "$PATCHED/source-revision.txt")" = db66022459ffb663aa2b50f6b018bc2e124f5edf ] || { echo "Unexpected MoltenVK source revision" >&2; exit 1; }
+shasum -a 256 -c "$PATCHED/SHA256SUMS"
+# Require this complete patch set, not an older manifest that only checks itself.
+shasum -a 256 "$HERE/patches/0001-isolate-vertex-input-cache.patch" \
+    "$HERE/patches/0002-warn-only-if-integer-blending-enabled.patch" \
+    "$HERE/patches/0003-size-cache-before-direct-export.patch" \
+    "$HERE/patches/0004-bound-pipeline-shader-cache.patch" \
+    "$HERE/patches/0005-account-for-nonserialized-cache-hint.patch" \
+    "$HERE/patches/0006-own-merged-specialization-libraries.patch" \
+    "$HERE/patches/0007-observe-metal-library-compile-inputs.patch" \
+    "$HERE/patches/0008-zero-unbound-vertex-inputs-opt-in.patch" \
+    "$HERE/patches/0009-select-metal-library-optimization.patch" \
+    "$HERE/patches/0010-integer-fragment-output-compatibility.patch" "$LIB" | cmp - "$PATCHED/SHA256SUMS"
+mkdir -p "$OBJ"
+SDK="$(xcrun --sdk iphoneos --show-sdk-path)"
+COMMON=(-arch arm64 -isysroot "$SDK" -miphoneos-version-min=17.0 -O2 -fPIC -fvisibility=hidden)
+xcrun --sdk iphoneos clang "${COMMON[@]}" -Wall -Wextra -Werror \
+    -I"$MVK/include" -c "$HERE/backend.c" -o "$OBJ/backend.o"
+for name in vulkan vulkan_thunks; do
+    xcrun --sdk iphoneos clang "${COMMON[@]}" -fno-strict-aliasing -fno-stack-protector \
+        -Werror=implicit-function-declaration \
