@@ -314,12 +314,20 @@ static void madeira_undo_appdata_skeleton(NSString *prefix)
  * logging. g_launch_exit holds (1 << 32) | status when the program ended with
  * an NTSTATUS error (0xC...), else 0. */
 static uint64_t g_launch_exit = 0;
+/* Latch completion independently of the crash status: a short program can
+ * start and exit between the library's half-second running-state polls. */
+static int g_launch_did_exit = 0;
 void wine_launched_process_did_exit(int status) {
     if ((uint32_t)status >= 0xC0000000u)
         __atomic_store_n(&g_launch_exit, (UINT64_C(1) << 32) | (uint32_t)status, __ATOMIC_RELEASE);
+    __atomic_store_n(&g_launch_did_exit, 1, __ATOMIC_RELEASE);
+}
+int wine_launched_process_has_exited(void) {
+    return __atomic_load_n(&g_launch_did_exit, __ATOMIC_ACQUIRE);
 }
 void wine_exit_status_reset(void) {
     __atomic_store_n(&g_launch_exit, 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&g_launch_did_exit, 0, __ATOMIC_RELEASE);
 }
 int wine_crash_exit_status(uint32_t *status) {
     uint64_t value = __atomic_load_n(&g_launch_exit, __ATOMIC_ACQUIRE);
diff --git a/app/Madeira/Winios/VulkanLayerGeometry.h b/app/Madeira/Winios/VulkanLayerGeometry.h
new file mode 100644
index 0000000000000000000000000000000000000000..754fc8b6853c3ed48c3692fc40f55294e82a12e4
--- /dev/null
+++ b/app/Madeira/Winios/VulkanLayerGeometry.h
@@ -0,0 +1,29 @@
+/* Vulkan's surface extent is in Wine client pixels, while the compositor
+ * places windows in UIKit points. Keep the layer's local coordinates in
+ * client pixels and scale its placement, rather than its bounds. MoltenVK
+ * compares drawableSize with bounds * contentsScale when acquiring images.
+ * Main thread only; applies to standalone compositor sublayers, not UIView
+ * backing layers. SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#import <QuartzCore/CAMetalLayer.h>
+#include <math.h>
+
+static inline BOOL madeira_vulkan_layer_geometry(CAMetalLayer *layer,
+                                                 CGRect pointFrame,
+                                                 CGSize clientPixels)
+{
+    if (!layer || !isfinite(clientPixels.width) || !isfinite(clientPixels.height) ||
+        clientPixels.width <= 0 || clientPixels.height <= 0 ||
+        !isfinite(pointFrame.origin.x) || !isfinite(pointFrame.origin.y) ||
+        !isfinite(pointFrame.size.width) || !isfinite(pointFrame.size.height) ||
+        pointFrame.size.width <= 0 || pointFrame.size.height <= 0)
+        return NO;
+    layer.anchorPoint = CGPointZero;
+    layer.contentsScale = 1;
+    layer.bounds = (CGRect){CGPointZero, clientPixels};
+    layer.affineTransform = CGAffineTransformMakeScale(
+        pointFrame.size.width / clientPixels.width,
+        pointFrame.size.height / clientPixels.height);
+    layer.position = pointFrame.origin;
+    return YES;
+}
