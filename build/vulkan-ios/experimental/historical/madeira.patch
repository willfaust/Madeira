+/* The existing stack sampler locates a wait, but not the guest object it waits
+ * for. Opt-in, read-only snapshots of the last x64->native exit fill that gap.
+ * Never call GetThreadContext/FEX/PE exports or suspend a target from here. */
+#include "ios_wait_state_diag.h"
+static int ios_wait_state_read(void *opaque, uint64_t address, void *out, size_t size)
+{
+    (void)opaque;
+    return ctx_peek(out, (const void *)(uintptr_t)address, size);
+}
+static void ios_capture_wait_state(uint64_t teb_address)
+{
+    static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+    static struct mw_diag state;
+    static int announced;
+    const char *setting=getenv("MADEIRA_WAIT_STATE_DIAGNOSTICS");
+    const TEB *teb=(const TEB *)(uintptr_t)teb_address;
+    const CHPE_V2_CPU_AREA_INFO *cpu=NULL;
+    const ARM64EC_NT_CONTEXT *saved=NULL;
+    ARM64EC_NT_CONTEXT before, after;
+    struct mw_input input={0};
+    struct mw_capture capture;
+    struct timespec now;
+    if (!setting || strcmp(setting,"1") || teb_address<0x10000) return;
+    /* trylock also makes reentrant/concurrent watchdog calls harmless. */
+    if (pthread_mutex_trylock(&lock)) return;
+    if (!announced) {
+        announced=1;
+        fprintf(stderr,"[wait-state] enabled read-only last-x64-exit snapshots; max=%u per-thread=%u interval=120s; no target suspension/writes\n",MW_TOTAL_LIMIT,MW_THREAD_LIMIT);
+    }
+    if (!ctx_peek(&cpu,&teb->ChpeV2CpuAreaInfo,sizeof(cpu)) || !cpu ||
+        !ctx_peek(&saved,&cpu->ContextAmd64,sizeof(saved)) || !saved ||
+        !ctx_peek(&before,saved,sizeof(before)) ||
+        !ctx_peek(&after,saved,sizeof(after)) || memcmp(&before,&after,sizeof(before))) goto done;
+    input.key=teb_address;
+    if (!ctx_peek(&input.tid,&teb->ClientId.UniqueThread,sizeof(input.tid))) goto done;
+    input.pc=before.Pc; input.sp=before.Sp;
+    input.regs[0]=before.X27; input.regs[1]=before.X25; input.regs[2]=before.X26;
+    input.regs[3]=before.X19; input.regs[4]=before.X20; input.regs[5]=before.X21;
+    input.regs[6]=before.X22; input.regs[7]=before.Fp;
+    input.regs[8]=before.X0; input.regs[9]=before.X1; input.regs[10]=before.X2;
+    input.regs[11]=before.X3; input.regs[12]=before.X8; input.regs[13]=before.X4;
+    input.regs[14]=before.X5;
+    if (clock_gettime(CLOCK_MONOTONIC,&now)) goto done;
+    if (mw_observe(&state,&input,(uint64_t)now.tv_sec,ios_wait_state_read,NULL,&capture))
+        mw_print(stderr,&input,&capture);
+ done:
+    pthread_mutex_unlock(&lock);
+}
