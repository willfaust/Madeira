+VKAPI_ATTR VkResult VKAPI_CALL vkAcquireNextImage2KHR(VkDevice d,const VkAcquireNextImageInfoKHR *i,uint32_t *idx)
+{ assert(d==(VkDevice)0x42 && i==expected_ai); *idx=3; return wsi_result; }
