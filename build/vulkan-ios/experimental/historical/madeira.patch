+        s->dynamic_count=dy.dynamicStateCount;
+        s->dynamics_copied=dy.pDynamicStates?(s->dynamic_count<DIAG_ARRAY?s->dynamic_count:DIAG_ARRAY):0;
+        if(!diag_read(s->dynamic,dy.pDynamicStates,s->dynamics_copied*sizeof(s->dynamic[0]))){s->dynamics_copied=0;s->read_error=1;}
+    }
+    VkPipelineRasterizationStateCreateInfo raster;
+    if(info->pRasterizationState && diag_read(&raster,info->pRasterizationState,sizeof(raster))){s->raster_present=1;s->raster_discard=raster.rasterizerDiscardEnable;}
+    else if(info->pRasterizationState)s->read_error=1;
+    VkPipelineColorBlendStateCreateInfo blend;
+    if(info->pColorBlendState && !diag_read(&blend,info->pColorBlendState,sizeof(blend)))s->read_error=1;
+    else if(info->pColorBlendState) {
+        s->blend_count=blend.attachmentCount;
+        s->blends_copied=blend.pAttachments?(s->blend_count<32?s->blend_count:32):0;
+        if(!diag_read(s->blends,blend.pAttachments,s->blends_copied*sizeof(s->blends[0]))){s->blends_copied=0;s->read_error=1;}
+    }
+    s->stage_count=info->stageCount;s->stages_copied=info->pStages?(s->stage_count<DIAG_STAGES?s->stage_count:DIAG_STAGES):0;
+    for(uint32_t i=0;i<s->stages_copied;i++) {
+        VkPipelineShaderStageCreateInfo stage;
+        struct diag_stage *st=&s->stages[i];
+        if(!diag_read(&stage,&info->pStages[i],sizeof(stage))){st->read_error=1;continue;}
+        const VkPipelineShaderStageCreateInfo *in=&stage;
+        st->stage=in->stage;st->flags=in->flags;st->module=in->module;st->next_count=diag_next_types(in->pNext,st->next_types,&st->read_error);
+        if(in->pName) {
+            size_t n;
+            for(n=0;n<sizeof(st->name)-1;n++) {
+                if(!diag_read(&st->name[n],in->pName+n,1)){st->read_error=1;break;}
+                if(!st->name[n])break;
+            }
+            if(n==sizeof(st->name)-1)st->name_truncated=1;
+        }
+        VkSpecializationInfo spec;
+        if(in->pSpecializationInfo && !diag_read(&spec,in->pSpecializationInfo,sizeof(spec)))st->read_error=1;
+        else if(in->pSpecializationInfo) {
+            st->spec_count=spec.mapEntryCount;st->spec_size=spec.dataSize;
+            st->spec_copied=spec.pMapEntries?(st->spec_count<DIAG_SPEC_ENTRIES?st->spec_count:DIAG_SPEC_ENTRIES):0;
+            st->spec_bytes=spec.pData?(st->spec_size<DIAG_SPEC_BYTES?st->spec_size:DIAG_SPEC_BYTES):0;
+            if(!diag_read(st->entries,spec.pMapEntries,st->spec_copied*sizeof(st->entries[0]))){st->spec_copied=0;st->read_error=1;}
+            if(!diag_read(st->data,spec.pData,st->spec_bytes)){st->spec_bytes=0;st->read_error=1;}
+        }
+        pthread_mutex_lock(&diag_lock);
+        struct diag_module *m=diag_modules;
+        while(m && (m->device!=device || m->module!=st->module))m=m->next;
+        if(m){st->blob=m->blob;st->blob->refs++;}
+        pthread_mutex_unlock(&diag_lock);
+    }
+    return s;
+}
+static void diag_snapshot_release(struct diag_snapshot *s)
+{
+    if(!s)return;
+    pthread_mutex_lock(&diag_lock);
+    for(uint32_t i=0;i<s->stages_copied;i++)diag_blob_release_locked(s->stages[i].blob);
+    diag_free_locked(s,sizeof(*s));pthread_mutex_unlock(&diag_lock);
+}
+static void diag_json_string(FILE *f,const char *s)
+{
+    fputc('"',f);
+    for(const unsigned char *p=(const unsigned char *)s;*p;p++) {
+        if(*p=='"' || *p=='\\'){fputc('\\',f);fputc(*p,f);}
+        else if(*p<32 || *p>=127)fprintf(f,"\\u%04x",*p);
+        else fputc(*p,f);
+    }
+    fputc('"',f);
+}
+static void diag_numbers(FILE *f,const uint32_t *values,uint32_t count)
+{
+    fputc('[',f);for(uint32_t i=0;i<count;i++)fprintf(f,"%s%u",i?",":"",values[i]);fputc(']',f);
+}
+static void diag_digest_hex(const unsigned char *digest,char *out)
+{
+    static const char digits[]="0123456789abcdef";
+    for(unsigned i=0;i<CC_SHA256_DIGEST_LENGTH;i++){out[i*2]=digits[digest[i]>>4];out[i*2+1]=digits[digest[i]&15];}
+    out[CC_SHA256_DIGEST_LENGTH*2]=0;
+}
+static void diag_write_failure(const struct diag_snapshot *s,uint64_t call,uint64_t thread,uint32_t index,uint32_t count,VkResult result)
+{
+    unsigned record;
+    pthread_mutex_lock(&diag_lock);
+    if(diag_failures>=8){pthread_mutex_unlock(&diag_lock);return;}
+    record=++diag_failures;pthread_mutex_unlock(&diag_lock);
+    char path[PATH_MAX];
+    if(snprintf(path,sizeof(path),"%s/pipeline-%02u-call-%" PRIu64 "-index-%u.json",diag_directory,record,call,index)>=(int)sizeof(path))return;
+    pthread_mutex_lock(&diag_io_lock);
+    FILE *f=fopen(path,"w");
+    if(!f){fprintf(stderr,"[vk-pipeline] failed to write metadata errno=%d\n",errno);pthread_mutex_unlock(&diag_io_lock);return;}
+    fprintf(f,"{\n\"schema\":1,\"call_id\":%" PRIu64 ",\"thread_id\":%" PRIu64 ",\"batch_result\":%d,\"batch_count\":%u,\"batch_member_index\":%u,\n",call,thread,result,count,index);
+    fprintf(f,"\"scope\":\"member of a failed native call; batch error does not prove every member failed\",\n\"flags\":%u,\"render_pass\":\"0x%" PRIx64 "\",\"subpass\":%u,\"pnext_type_ids\":",s->flags,(uint64_t)(uintptr_t)s->render_pass,s->subpass);
+    diag_numbers(f,s->next_types,s->next_count);
+    fprintf(f,",\n\"vertex_input\":{\"present\":%s,\"binding_count\":%u,\"attribute_count\":%u,\"bindings_copied\":%u,\"attributes_copied\":%u,\"pnext_type_ids\":",s->vi_present?"true":"false",s->binding_count,s->attribute_count,s->bindings_copied,s->attributes_copied);
+    diag_numbers(f,s->vi_next_types,s->vi_next_count);fputs(",\"bindings\":[",f);
+    for(uint32_t i=0;i<s->bindings_copied;i++)fprintf(f,"%s{\"binding\":%u,\"stride\":%u,\"input_rate\":%u}",i?",":"",s->bindings[i].binding,s->bindings[i].stride,s->bindings[i].inputRate);
+    fputs("],\"attributes\":[",f);
+    for(uint32_t i=0;i<s->attributes_copied;i++)fprintf(f,"%s{\"location\":%u,\"binding\":%u,\"format\":%u,\"offset\":%u}",i?",":"",s->attributes[i].location,s->attributes[i].binding,s->attributes[i].format,s->attributes[i].offset);
+    fprintf(f,"]},\n\"dynamic_state_count\":%u,\"dynamic_states\":",s->dynamic_count);diag_numbers(f,(const uint32_t *)s->dynamic,s->dynamics_copied);
+    fprintf(f,",\n\"raster_state_present\":%s,\"rasterizer_discard_enable\":%u,\"blend_attachment_count\":%u,\"blend_attachments\":[",s->raster_present?"true":"false",s->raster_discard,s->blend_count);
+    for(uint32_t i=0;i<s->blends_copied;i++) {
+        const VkPipelineColorBlendAttachmentState *b=&s->blends[i];
+        fprintf(f,"%s{\"blend_enable\":%u,\"src_color\":%u,\"dst_color\":%u,\"color_op\":%u,\"src_alpha\":%u,\"dst_alpha\":%u,\"alpha_op\":%u,\"write_mask\":%u}",i?",":"",b->blendEnable,b->srcColorBlendFactor,b->dstColorBlendFactor,b->colorBlendOp,b->srcAlphaBlendFactor,b->dstAlphaBlendFactor,b->alphaBlendOp,b->colorWriteMask);
+    }
+    fprintf(f,"],\n\"stage_count\":%u,\"stages_copied\":%u,\"stages\":[",s->stage_count,s->stages_copied);
+    for(uint32_t i=0;i<s->stages_copied;i++) {
+        const struct diag_stage *st=&s->stages[i];char hex[65],filename[96];int written=0;
+        fprintf(f,"%s{\"stage\":%u,\"flags\":%u,\"module\":\"0x%" PRIx64 "\",\"entry_point\":",i?",":"",st->stage,st->flags,(uint64_t)(uintptr_t)st->module);diag_json_string(f,st->name);
+        fprintf(f,",\"capture_read_error\":%u,\"entry_point_truncated\":%s,\"pnext_type_ids\":",st->read_error,st->name_truncated?"true":"false");diag_numbers(f,st->next_types,st->next_count);
+        if(st->blob) {
+            diag_digest_hex(st->blob->digest,hex);snprintf(filename,sizeof(filename),"shader-%s.spv",hex);
+            char shader_path[PATH_MAX];
+            if(snprintf(shader_path,sizeof(shader_path),"%s/%s",diag_directory,filename)<(int)sizeof(shader_path)) {
+                FILE *sf=fopen(shader_path,"wb");
+                if(sf){written=fwrite(st->blob->bytes,1,st->blob->size,sf)==st->blob->size;int closed=fclose(sf);if(closed)written=0;}
+            }
+            fprintf(f,",\"sha256\":\"%s\",\"spirv_bytes\":%zu,\"spirv_file\":",hex,st->blob->size);
+            if(written)diag_json_string(f,filename);else fputs("null",f);
+        } else fputs(",\"sha256\":null,\"spirv_file\":null",f);
+        fprintf(f,",\"specialization\":{\"entry_count\":%u,\"data_size\":%zu,\"data_bytes_copied\":%zu,\"entries\":[",st->spec_count,st->spec_size,st->spec_bytes);
+        for(uint32_t j=0;j<st->spec_copied;j++)fprintf(f,"%s{\"constant_id\":%u,\"offset\":%u,\"size\":%zu}",j?",":"",st->entries[j].constantID,st->entries[j].offset,st->entries[j].size);
+        fputs("],\"data_hex\":\"",f);for(size_t j=0;j<st->spec_bytes;j++)fprintf(f,"%02x",st->data[j]);fputs("\"}}",f);
+    }
+    fprintf(f, "],\n\"capture_read_error\":%u,\n",s->read_error);
+    fputs("\"capture_limits\":\"32 stages/pNext types, 256 bindings/attributes/dynamic states, 32 blend attachments, 64 specialization entries and 4096 data bytes per stage; pNext IDs only, unknown payloads not copied\"\n}\n",f);
+    int error=ferror(f);if(fclose(f))error=1;
+    fprintf(stderr,"[vk-pipeline] failed native call=%" PRIu64 " thread=%" PRIu64 " result=%d batch=%u member=%u metadata=%s io_error=%d\n",call,thread,result,count,index,path,error);
+    pthread_mutex_unlock(&diag_io_lock);
+}
+static VkResult VKAPI_CALL diag_create_graphics_pipelines(VkDevice device,VkPipelineCache cache,uint32_t count,
+        const VkGraphicsPipelineCreateInfo *infos,const VkAllocationCallbacks *allocator,VkPipeline *pipelines)
+{
+    if(!diag_on())return vkCreateGraphicsPipelines(device,cache,count,infos,allocator,pipelines);
+    struct diag_snapshot *snapshots[8]={0};
+    struct madeira_vertex_stamp stamp=madeira_stamp(count,infos,diag_read);
+    uint64_t call=__atomic_add_fetch(&diag_call_id,1,__ATOMIC_RELAXED),thread=0;
+#ifdef __APPLE__
+    pthread_threadid_np(NULL,&thread);
+#else
+    thread=(uint64_t)(uintptr_t)pthread_self();
+#endif
+    pthread_mutex_lock(&diag_lock);int room=diag_failures<8;pthread_mutex_unlock(&diag_lock);
+    uint32_t captured=room && infos ? (count<8?count:8):0;
+    for(uint32_t i=0;i<captured;i++)snapshots[i]=diag_snapshot_create(device,&infos[i]);
+    VkResult result=vkCreateGraphicsPipelines(device,cache,count,infos,allocator,pipelines);
+    if(result<0) {
+        static unsigned boundary_failures;
+        if(__atomic_add_fetch(&boundary_failures,1,__ATOMIC_RELAXED)<=32)
+            fprintf(stderr,"[vk-boundary] Unix-entry infos=%p count=%u vertex_hash=%016" PRIx64 " complete=%d result=%d\n",
+                    (const void *)infos,count,stamp.hash,stamp.complete,result);
+        fprintf(stderr,"[vk-pipeline] native vkCreateGraphicsPipelines failed call=%" PRIu64 " thread=%" PRIu64 " result=%d batch=%u\n",call,thread,result,count);
+        for(uint32_t i=0;i<captured;i++)if(snapshots[i])diag_write_failure(snapshots[i],call,thread,i,count,result);
+    }
+    for(uint32_t i=0;i<captured;i++)diag_snapshot_release(snapshots[i]);
+    return result;
+}
