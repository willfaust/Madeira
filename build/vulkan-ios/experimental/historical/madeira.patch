diff --git a/tests/vulkan/integer-output-spirv-alias.cpp b/tests/vulkan/integer-output-spirv-alias.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5e48a2fc1c62a6412b90a69b45bee1d8eafee996
--- /dev/null
+++ b/tests/vulkan/integer-output-spirv-alias.cpp
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+// Build with MoltenVKShaderConverter + SPIRV-Tools include directories and
+// libSPIRVTools.a. Checks a valid shader is rejected before an invalid rewrite.
+#include "SPIRVIntegerFragmentOutputs.h"
+#include <spirv-tools/libspirv.hpp>
+#include <iostream>
+int main(){
+ const std::string assembly=R"(OpCapability Shader
+OpMemoryModel Logical GLSL450
+OpEntryPoint Fragment %main "main" %out
+OpExecutionMode %main OriginUpperLeft
+OpDecorate %out Location 0
+%void = OpTypeVoid
+%fn = OpTypeFunction %void
+%float = OpTypeFloat 32
+%output = OpTypePointer Output %float
+%local = OpTypePointer Function %float
+%zero = OpConstant %float 0
+%out = OpVariable %output Output
+%main = OpFunction %void None %fn
+%label = OpLabel
+%tmp = OpVariable %local Function
+OpStore %tmp %zero
+OpCopyMemory %out %tmp
+OpReturn
+OpFunctionEnd
+)";
+ spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_1);std::vector<uint32_t> input,output;std::string error;
+ tools.SetMessageConsumer([](spv_message_level_t,const char*,const spv_position_t&,const char* message){std::cerr<<message<<"\n";});
+ for(unsigned direction=0;direction<2;direction++) {
+  auto code=assembly;
+  if(direction)code.replace(code.find("OpCopyMemory %out %tmp"),std::string("OpCopyMemory %out %tmp").size(),"OpCopyMemory %tmp %out");
+  if(!tools.Assemble(code,&input)||!tools.Validate(input))return 1;
+  if(mvk::integerFragmentOutputs(input,1,0,output,error)||error.empty())return 2;
+ }
+ std::cout<<"PASS valid OpCopyMemory input rejected safely for source and destination pointers\n";
+}
diff --git a/tests/vulkan/metal-library-options.mm b/tests/vulkan/metal-library-options.mm
new file mode 100644
index 0000000000000000000000000000000000000000..ce5899c8076d5281b2e9d32d85c569faf90f0f80
--- /dev/null
+++ b/tests/vulkan/metal-library-options.mm
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MIT
+// Observe the real Metal compiler boundary; never replace the compiler/output.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <objc/runtime.h>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+extern "C" int vulkan_probe_main(int, char**);
+static IMP original;
+static std::atomic<unsigned> observed{0}, wrong{0};
+static MTLLibraryOptimizationLevel expected;
+static void compile(id self, SEL sel, NSString* source, MTLCompileOptions* options,
+                    void (^done)(id<MTLLibrary>, NSError*)) {
+    observed++;
+    if (options.optimizationLevel != expected) wrong++;
+    using Fn = void (*)(id, SEL, NSString*, MTLCompileOptions*, void (^)(id<MTLLibrary>, NSError*));
+    ((Fn)original)(self, sel, source, options, done);
+}
+int main(int argc, char** argv) { @autoreleasepool {
+    const char* policy = getenv("MADEIRA_VK_METAL_LIBRARY_OPTIMIZATION");
+    expected = policy && !strcmp(policy, "size") ? MTLLibraryOptimizationLevelSize : MTLLibraryOptimizationLevelDefault;
+    id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+    SEL sel = @selector(newLibraryWithSource:options:completionHandler:);
+    Method method = class_getInstanceMethod(object_getClass(dev), sel);
+    if (!dev || !method) return 2;
+    original = method_setImplementation(method, (IMP)compile);
+    int result = vulkan_probe_main(argc, argv);
+    method_setImplementation(method, original);
+    printf("OPTIONS expected=%lu observed=%u wrong=%u GPU-result=%d\n", (unsigned long)expected, observed.load(), wrong.load(), result);
+    return result || !observed || wrong ? 1 : 0;
+}}
diff --git a/tests/vulkan/shader-compiler-ledger.mm b/tests/vulkan/shader-compiler-ledger.mm
new file mode 100644
index 0000000000000000000000000000000000000000..db496e56b2b1c16c1b1f4089811f3506a5174c42
--- /dev/null
+++ b/tests/vulkan/shader-compiler-ledger.mm
@@ -0,0 +1,33 @@
+#import <Metal/Metal.h>
+#import <Foundation/Foundation.h>
+#define MVK_XCODE_16 1
+#include "MVKShaderCompilerDiagnostics.h"
+#include <cassert>
+int main() { @autoreleasepool {
+    setenv("MADEIRA_VK_SHADER_COMPILE_DIAGNOSTICS", "1", 1);
+    MTLCompileOptions* o = [MTLCompileOptions new];
+    id<MTLDevice> d = MTLCreateSystemDefaultDevice();
+    auto record = [&](NSString* s, unsigned expected) {
+        auto t = madeiraCompilerDiagnostics::begin(s, o, d);
+        assert(t.enabled && t.category == expected);
+        madeiraCompilerDiagnostics::end(t, true);
+    };
+    record(@"source-a", 0); record(@"source-a", 1);
+    o.preprocessorMacros = @{@"COUNT": @6}; record(@"source-a", 0); record(@"source-a", 1);
+    o.preprocessorMacros = @{@"COUNT": @7}; record(@"source-a", 0);
+    o.preserveInvariance = YES; record(@"source-a", 0);
+    o.preprocessorMacros = @{@"COUNT": @7, @"OTHER": @3}; record(@"source-a", 0);
+    o.preprocessorMacros = @{@"OTHER": @3, @"COUNT": @7}; record(@"source-a", 1);
+    bool sawOverflow = false;
+    for (unsigned i = 0; i < 34000; ++i) {
+        auto t = madeiraCompilerDiagnostics::begin([NSString stringWithFormat:@"source-%u", i], o, d);
+        assert(t.category != 1); sawOverflow |= t.category == 2;
+        madeiraCompilerDiagnostics::end(t, true);
+    }
+    assert(sawOverflow);
+    record(@"source-a", 1); // Existing fingerprints survive table saturation.
+    auto& l = madeiraCompilerDiagnostics::ledger();
+    assert(l.counts[0] <= 32768 && l.counts[0] + l.counts[1] + l.counts[2] == l.completed);
+    printf("PASS bounded-ledger macro-values option-differences canonical-macro-order saturation; bytes=%zu\n", sizeof(l));
+    [o release]; [d release];
+} }
