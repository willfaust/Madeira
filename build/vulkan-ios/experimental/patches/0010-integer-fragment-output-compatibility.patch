diff --git a/MoltenVKShaderConverter/MoltenVKShaderConverter/SPIRVIntegerFragmentOutputs.h b/MoltenVKShaderConverter/MoltenVKShaderConverter/SPIRVIntegerFragmentOutputs.h
new file mode 100644
--- /dev/null
+++ b/MoltenVKShaderConverter/MoltenVKShaderConverter/SPIRVIntegerFragmentOutputs.h
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <initializer_list>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace mvk {
+// Compatibility for Vulkan's undefined float output / integer attachment case.
+// Change only a private compiler copy, preserving the original module and value
+// bits. Restricted to directly located 32-bit scalar/vector output variables.
+inline bool integerFragmentOutputs(const std::vector<uint32_t>& input,
+                                   uint32_t unsignedMask, uint32_t signedMask,
+                                   std::vector<uint32_t>& output, std::string& error) {
+    output = input;
+    if (!(unsignedMask | signedMask)) { return true; }
+    if (input.size() < 5 || input[0] != 0x07230203) { error="Invalid SPIR-V header"; return false; }
+    struct Type { uint32_t op=0, base=0, size=0, storage=0; };
+    struct Decorations { uint32_t location=~0u, component=0, index=0; bool builtin=false; };
+    struct Variable { uint32_t oldType, type, pointer; };
+    std::map<uint32_t, Type> types;
+    std::map<uint32_t, Decorations> decorations;
+    std::map<uint32_t, Variable> variables;
+    std::vector<std::vector<uint32_t>> instructions;
+    for (size_t i=5; i<input.size();) {
+        uint32_t count=input[i]>>16, op=input[i]&65535;
+        if (!count || count>input.size()-i) { error="Invalid SPIR-V instruction"; return false; }
+        std::vector<uint32_t> w(input.begin()+i,input.begin()+i+count);
+        instructions.push_back(w);
+        if (op==21 && count==4) { types[w[1]]={op,w[3],w[2],0}; }
+        if (op==22 && count==3) { types[w[1]]={op,0,w[2],0}; }
+        if (op==23 && count==4) { types[w[1]]={op,w[2],w[3],0}; }
+        if (op==32 && count==4) { types[w[1]]={op,w[3],0,w[2]}; }
+        if (op==71 && count>=3) {
+            auto& d=decorations[w[1]];
+            if (w[2]==11) { d.builtin=true; }
+            if (count>=4) {
+                if(w[2]==30) d.location=w[3];
+                if(w[2]==31) d.component=w[3];
+                if(w[2]==32) d.index=w[3];
+            }
+        }
+        i+=count;
+    }
+    uint32_t bound=input[3];
+    auto id=[&]() { return bound++; };
+    std::vector<uint32_t> declarations;
+    auto emit=[&](std::initializer_list<uint32_t> w) { declarations.insert(declarations.end(),w); };
+    std::set<uint32_t> movedTypes;
+    // Reuse existing integer/vector/pointer types, moving their declarations
+    // ahead of global variables. SPIR-V prohibits duplicate scalar types.
+    auto scalarType=[&](uint32_t sign) {
+        uint32_t result=0;
+        for(const auto& t:types) if(t.second.op==21 && t.second.size==32 && t.second.base==sign) { result=t.first;break; }
+        if(!result){result=id();types[result]={21,sign,32,0};}
+        if(movedTypes.insert(result).second) emit({(4u<<16)|21,result,32,sign});
+        return result;
+    };
+    auto vectorType=[&](uint32_t base,uint32_t width) {
+        uint32_t result=0;
+        for(const auto& t:types) if(t.second.op==23 && t.second.base==base && t.second.size==width) {result=t.first;break;}
+        if(!result){result=id();types[result]={23,base,width,0};}
+        if(movedTypes.insert(result).second) emit({(4u<<16)|23,result,base,width});
+        return result;
+    };
+    auto pointerType=[&](uint32_t base) {
+        uint32_t result=0;
+        for(const auto& t:types) if(t.second.op==32 && t.second.base==base && t.second.storage==3) {result=t.first;break;}
+        if(!result){result=id();types[result]={32,base,0,3};}
+        if(movedTypes.insert(result).second) emit({(4u<<16)|32,result,3,base});
+        return result;
+    };
+    for (const auto& w:instructions) {
+        if ((w[0]&65535)!=59 || w.size()<4 || w[3]!=3) continue; // OpVariable Output
+        auto d=decorations[w[2]];
+        if(d.builtin || d.component || d.index || d.location>=32) continue;
+        uint32_t bit=1u<<d.location;
+        if(!((unsignedMask|signedMask)&bit)) continue;
+        Type ptr=types[w[1]], type=types[ptr.base];
+        Type scalar=type.op==23 ? types[type.base] : type;
+        if(ptr.op!=32 || ptr.storage!=3 || scalar.op!=22 || scalar.size!=32 ||
+           (type.op!=22 && (type.op!=23 || type.size<2 || type.size>4))) continue;
+        if(w.size()!=4) { error="Initialized fragment output is unsupported by integer compatibility"; return false; }
+        uint32_t typeID=scalarType((signedMask&bit)?1u:0u);
+        if(type.op==23) typeID=vectorType(typeID,type.size);
+        uint32_t pointerID=pointerType(typeID);
+        variables[w[2]]={ptr.base,typeID,pointerID};
+    }
+    if(variables.empty()) return true;
+    // Do not guess pointer-alias/component/block transformations. They need
+    // separate handling rather than silently producing a partially valid module.
+    for(const auto& w:instructions) {
+        uint32_t op=w[0]&65535;
+        if ((op==63 || op==64) && w.size()>=3 &&
+            (variables.count(w[1]) || variables.count(w[2]))) {
+            error="Copied fragment output pointer is unsupported by integer compatibility";return false;
+        }
+        if (op==62 && w.size()>=3 && variables.count(w[2])) {
+            error="Stored fragment output pointer is unsupported by integer compatibility";return false;
+        }
+        if (op==254 && w.size()>=2 && variables.count(w[1])) {
+            error="Returned fragment output pointer is unsupported by integer compatibility";return false;
+        }
+        if(op==169 || op==65 || op==66 || op==67 || op==70 || op==83 || op==57 || op==245) {
+            for(size_t j=3;j<w.size();j++) if(variables.count(w[j])) {
+                error="Aliased/composite fragment output is unsupported by integer compatibility";return false;
+            }
+        }
+    }
+    output.assign(input.begin(),input.begin()+5);
+    bool inserted=false;
+    for(auto w:instructions) {
+        uint32_t op=w[0]&65535;
+        if(!inserted && op>=19 && op<=39) {
+            output.insert(output.end(),declarations.begin(),declarations.end());inserted=true;
+        }
+        if(op>=19 && op<=39 && w.size()>1 && movedTypes.count(w[1])) continue;
+        if(op==59 && w.size()>=4 && variables.count(w[2])) w[1]=variables.at(w[2]).pointer;
+        if(op==62 && w.size()>=3 && variables.count(w[1])) {
+            const auto& var=variables.at(w[1]);uint32_t value=id();
+            output.insert(output.end(),{(4u<<16)|124,var.type,value,w[2]});w[2]=value;
+        }
+        if(op==61 && w.size()>=4 && variables.count(w[3])) {
+            const auto& var=variables.at(w[3]);uint32_t result=w[2], value=id();
+            w[1]=var.type;w[2]=value;output.insert(output.end(),w.begin(),w.end());
+            output.insert(output.end(),{(4u<<16)|124,var.oldType,result,value});continue;
+        }
+        output.insert(output.end(),w.begin(),w.end());
+    }
+    if(!inserted || bound<input[3]) { error="Invalid SPIR-V type section or ID bound";return false; }
+    output[3]=bound;
+    return true;
+}
+}
