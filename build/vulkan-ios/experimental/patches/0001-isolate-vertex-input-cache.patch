 	}
 
 	for (const auto& so : shaderOutputs) {
@@ -387,6 +394,29 @@ MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::convert(SPIRVToMSLConversionConfigur
 			ctxSI.outIsUsedByShader = pMSLCompiler->is_msl_shader_input_used(ctxSI.shaderVar.location);
 		}
 	}
+	// This is an optimization hint, never evidence that incomplete input is
+	// valid. Complex interfaces conservatively retain full-layout matching.
+	shaderConfig.vertexInputsFullyCovered = false;
+	if (pMSLCompiler && shaderConfig.options.entryPointStage == ExecutionModelVertex) {
+		bool covered = true;
+		for (const auto& input : pMSLCompiler->get_shader_resources().stage_inputs) {
+			const auto& type = pMSLCompiler->get_type(input.type_id);
+			if (!pMSLCompiler->has_decoration(input.id, DecorationLocation) ||
+				!type.array.empty() || type.columns != 1 || type.width > 32 ||
+				(type.basetype != SPIRType::Float && type.basetype != SPIRType::Int && type.basetype != SPIRType::UInt) ||
+				pMSLCompiler->get_decoration(input.id, DecorationComponent) != 0) {
+				covered = false;
+				break;
+			}
+			uint32_t location = pMSLCompiler->get_decoration(input.id, DecorationLocation);
+			if (pMSLCompiler->is_msl_shader_input_used(location) &&
+				!shaderConfig.isShaderInputLocationUsed(location)) {
+				covered = false;
+				break;
+			}
+		}
+		shaderConfig.vertexInputsFullyCovered = covered;
+	}
 	for (auto& ctxSO : shaderConfig.shaderOutputs) {
 		if (ctxSO.shaderVar.builtin != spv::BuiltInMax) {
 			ctxSO.outIsUsedByShader = pMSLCompiler->has_active_builtin(ctxSO.shaderVar.builtin, spv::StorageClassOutput);
