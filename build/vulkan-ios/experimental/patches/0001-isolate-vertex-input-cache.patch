@@ -192,8 +192,15 @@ MVK_PUBLIC_SYMBOL bool SPIRVToMSLConversionConfiguration::matches(const SPIRVToM
 
     if ( !options.matches(other.options) ) { return false; }
 
+	// Incomplete or deserialized vertex configurations must not hide inputs
+	// absent from their recorded layout. Fully covered configurations can use
+	// the upstream used-input comparison, so unused attributes do not force
+	// redundant MSL conversions and Metal library compilations.
+	bool compareAllInputs = options.entryPointStage == ExecutionModelVertex && !vertexInputsFullyCovered;
+	if (compareAllInputs && shaderInputs.size() != other.shaderInputs.size()) { return false; }
 	for (const auto& si : shaderInputs) {
-		if (si.outIsUsedByShader && !containsMatching(other.shaderInputs, si)) { return false; }
+		if ((compareAllInputs || si.outIsUsedByShader) &&
