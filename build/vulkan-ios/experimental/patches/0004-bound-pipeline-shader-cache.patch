+// Include macro-specialized libraries; reserve one unit for empty/failed groups
+// so repeated failures cannot accumulate an unbounded map of empty caches.
+size_t MVKShaderLibraryCache::residentLibraryCount() const {
+    size_t count = 0;
+    for (auto& pair : _shaderLibraries) {
+        count += 1 + pair.second->_specializationVariants.size();
+    }
+    return std::max(size_t(1), count);
+}
