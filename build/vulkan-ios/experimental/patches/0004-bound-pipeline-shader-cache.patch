+// Local iOS cache residency policy. Zero explicitly preserves upstream unlimited
+// caching. Other platforms keep the upstream default unless explicitly selected.
+static uint32_t mvkShaderLibraryLimit() {
+    static const uint32_t limit = [] {
+#if MVK_IOS
+        uint32_t fallback = 256;
+#else
+        uint32_t fallback = 0;
+#endif
+        const char* text = getenv("MADEIRA_VK_SHADER_CACHE_MAX_LIBRARIES");
+        if (!text || !*text || *text == '-') { return fallback; }
+        char* end = nullptr;
+        errno = 0;
+        unsigned long value = strtoul(text, &end, 10);
+        return errno || *end || value > std::numeric_limits<uint32_t>::max() ? fallback : uint32_t(value);
+    }();
+    return limit;
+}
+
+void MVKPipelineCache::trimShaderCache() {
+    if (!_shaderLibraryLimit) { return; }
+    size_t count = 0;
+    for (auto& pair : _shaderCache) { count += pair.second->residentLibraryCount(); }
+    bool trimmed = false;
+    while (count > _shaderLibraryLimit && !_shaderCache.empty()) {
+        auto oldest = _shaderCache.begin();
+        for (auto it = _shaderCache.begin(); it != _shaderCache.end(); ++it) {
+            if (it->second->_lastCacheUse < oldest->second->_lastCacheUse) { oldest = it; }
+        }
+        count -= oldest->second->residentLibraryCount();
+        oldest->second->destroy();
+        _shaderCache.erase(oldest);
+        ++_shaderCacheEvictions;
+        trimmed = true;
+    }
+    if (trimmed) {
+        markDirty();
+        if (_shaderCacheEvictions <= 4 || _shaderCacheEvictions % 512 == 0) {
+            fprintf(stderr, "[vk-cache] cache=%p limit=%u resident-library-units=%zu evicted-groups=%llu\n",
+                    this, _shaderLibraryLimit, count, (unsigned long long)_shaderCacheEvictions);
+        }
+    }
 }
 
