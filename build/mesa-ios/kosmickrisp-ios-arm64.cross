# Meson cross file for KosmicKrisp (Mesa's Vulkan-on-Metal driver), iOS arm64
# device. @SDK@ is filled in by build-kosmickrisp.sh. The driver is written
# against Metal 4 (MTL4CommandQueue, MTL4Compiler, MTL4ArgumentTable), which
# iOS has from 26.0, so 26.0 is the deployment target; the app itself can stay
# older and only dlopen this library on iOS 26.
[binaries]
c = ['xcrun', '-sdk', 'iphoneos', 'clang']
cpp = ['xcrun', '-sdk', 'iphoneos', 'clang++']
objc = ['xcrun', '-sdk', 'iphoneos', 'clang']
ar = ['xcrun', '-sdk', 'iphoneos', 'ar']
strip = ['xcrun', '-sdk', 'iphoneos', 'strip']
pkg-config = 'false'

[built-in options]
c_args = ['-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=26.0']
cpp_args = ['-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=26.0']
objc_args = ['-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=26.0']
c_link_args = ['-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=26.0']
cpp_link_args = ['-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=26.0']
objc_link_args = ['-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=26.0']

[host_machine]
system = 'darwin'
subsystem = 'ios'
kernel = 'xnu'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'
