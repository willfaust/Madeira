+
+/* Madeira: a variable's GLSL name goes into the SPIR-V as OpName, and
+ * MoltenVK's SPIRV-Cross keeps it in the Metal source it compiles. A name that
+ * is a Metal type or keyword then breaks the shader: a sampler2DMS uniform
+ * called "sampler" became `texture2d_ms<float> sampler`, which hides Metal's
+ * sampler type, so the fragment shader did not compile and every draw with it
+ * was skipped. Prefix variable names so no application name can collide; they
+ * are debug names only (bindings and locations come from decorations).
+ */
+static void
+emit_var_name(struct ntv_context *ctx, SpvId var_id, const char *name)
+{
+   char buf[256];
+   snprintf(buf, sizeof(buf), "v_%s", name);
+   spirv_builder_emit_name(&ctx->builder, var_id, buf);
+}
+
