+/* Madeira: Metal 4 does not synchronise or page in CAMetalLayer drawables on
+ * its own. Before a command buffer that writes a drawable is committed, the
+ * queue must wait for the display to release it, and the layer's residency
+ * set must be on the queue. Without this the copy into the drawable can be
+ * lost and the window stays black. MADEIRA_KK_DRAWABLE_SYNC=0 turns it off. */
+static void
+kk_queue_prepare_drawable(struct kk_queue *queue, void *drawable)
+{
+   mtl_residency_set *set = mtl_drawable_get_layer_residency_set(drawable);
+   if (set) {
+      bool known = false;
+      for (uint32_t i = 0; i < queue->layer_set_count; i++)
+         known |= queue->layer_sets[i] == set;
+      if (!known) {
+         if (queue->layer_set_count == ARRAY_SIZE(queue->layer_sets)) {
+            mtl_command_queue_remove_residency_set(queue->mtl_handle,
+                                                   queue->layer_sets[0]);
+            mtl_release(queue->layer_sets[0]);
+            memmove(&queue->layer_sets[0], &queue->layer_sets[1],
+                    sizeof(queue->layer_sets[0]) * (queue->layer_set_count - 1));
+            queue->layer_set_count--;
+         }
+         mtl_command_queue_add_residency_set(queue->mtl_handle, set);
+         queue->layer_sets[queue->layer_set_count++] = mtl_retain(set);
+      }
+   }
+   mtl_command_queue_wait_for_drawable(queue->mtl_handle, drawable);
+}
