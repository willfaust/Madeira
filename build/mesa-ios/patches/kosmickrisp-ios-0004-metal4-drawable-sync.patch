+/* Returns the presenting layer's residency set (not retained), or NULL when
+ * the drawable has no CAMetalLayer or the OS has no layer residency sets. */
+mtl_residency_set *
+mtl_drawable_get_layer_residency_set(void *drawable)
+{
+   @autoreleasepool {
+      id d = (id)drawable;
+      if (![d respondsToSelector:@selector(layer)])
+         return NULL;
+      CAMetalLayer *layer = [(id<CAMetalDrawable>)d layer];
+      if (!layer || ![layer respondsToSelector:@selector(residencySet)])
+         return NULL;
+      return (mtl_residency_set *)layer.residencySet;
+   }
+}
