+       intr->intrinsic != nir_intrinsic_load_interpolated_input)
+      return NULL;
+   if (intr->def.bit_size != 32 || !nir_src_is_const(*nir_get_io_offset_src(intr)))
+      return NULL;
+   *sem = nir_intrinsic_io_semantics(intr);
+   if (sem->num_slots != 1 || nir_src_as_uint(*nir_get_io_offset_src(intr)) ||
+       !fs_input_widen_slot(sem->location))
+      return NULL;
+   return sem;
+}
+
+static bool
+fs_input_widen_scan(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
