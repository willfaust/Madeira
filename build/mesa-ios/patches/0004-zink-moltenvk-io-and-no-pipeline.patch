+static bool
+fs_input_widen_slot(gl_varying_slot slot)
+{
+   return slot == VARYING_SLOT_COL0 || slot == VARYING_SLOT_COL1 ||
+          slot == VARYING_SLOT_BFC0 || slot == VARYING_SLOT_BFC1 ||
+          (slot >= VARYING_SLOT_TEX0 && slot <= VARYING_SLOT_TEX7) ||
+          (slot >= VARYING_SLOT_VAR0 && slot < VARYING_SLOT_VAR0 + 32);
+}
