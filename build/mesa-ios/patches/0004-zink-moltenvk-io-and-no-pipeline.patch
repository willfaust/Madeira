+ * input(s) user(locn0_3) mismatching vertex shader output"). Widen every read
+ * of such a slot to start at component 0 so rework_io_vars makes one variable
+ * covering components [0, highest read]. Slots already read only from
+ * component 0 are left alone. */
+struct fs_input_widen {
+   uint8_t end[VARYING_SLOT_MAX];     /* highest component read + 1 */
+   uint64_t offset_reads;             /* slots with a read at component != 0 */
+};
