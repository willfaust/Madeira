@@ -81,6 +81,7 @@ kk_release_compiler(struct kk_device *dev)
 {
    /* KK_WORKAROUND_11 */
    if (dev->disabled_workarounds & BITFIELD64_BIT(11)) {
+      mtl_compiler_flush_archive(dev->mtl_compiler_handle);
       mtl_release(dev->mtl_compiler_handle);
       return;
    }
@@ -95,6 +96,8 @@ kk_release_compiler(struct kk_device *dev)
 
       if (compiler->refcount == 0) {
          _mesa_hash_table_remove(&compilers_ht, ent);
