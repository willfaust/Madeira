+/* Runs the stage before the geometry shader (vertex or tess eval, as compute)
+ * and the geometry shader (as compute), then returns the draw that rasterizes
+ * what the geometry shader wrote, with its rasterization shader as the vertex
+ * function. Follows honeykrisp's hk_launch_gs_prerast, without the count and
+ * pre-GS programs, which only transform feedback and statistics queries need.
+ *
+ * in_prim is the primitive type the geometry shader reads: the draw's, or the
+ * tessellator's output.
+ */
+static struct kk_draw_data
+kk_launch_gs(struct kk_cmd_buffer *cmd, struct kk_draw_data draw,
+             enum mesa_prim in_prim)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   struct kk_shader *tes = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   const struct poly_gs_info *gsi = &vs->info.vs.gs;
+   bool indirect = kk_grid_is_indirect(draw.grid);
+
+   /* The stage before the geometry shader: with tessellation that is the tess
+    * eval shader, run as compute over the tessellator's indices, whose outputs
+    * need vertex params of their own. */
+   uint64_t prev_outputs = vs->info.vs.outputs_written;
+   mtl_compute_pipeline_state *prev_pipeline = vs->pipeline.gfx.pre_render[0];
+   if (tes) {
+      prev_outputs = tes->info.tess.tes_outputs_written;
+      prev_pipeline = vs->pipeline.gfx.pre_render[2];
+
+      const uint32_t wg_size[3] = {64, 1, 1};
+      struct poly_vertex_params vp;
+      poly_vertex_params_init(&vp, prev_outputs, wg_size);
+      gfx->per_draw_data.vertex_params =
+         kk_pool_upload(cmd, &vp, sizeof(vp), 8).gpu;
+      gfx->per_draw_data.vertex_outputs = prev_outputs;
+      /* Tess eval reads its vertex from the tessellator's index buffer
+       * itself (poly_load_tes_index); no software index pull. */
+      gfx->per_draw_data.index_size = 0u;
+      /* The tessellator emits its own winding, first vertex provoking. */
+      gfx->per_draw_data.provoking_last = false;
+   }
+
