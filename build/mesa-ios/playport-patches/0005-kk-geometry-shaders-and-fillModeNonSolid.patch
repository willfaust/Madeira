+ * (kk_build_point_fill_gs) that turns each triangle into its three vertices as
+ * points, after culling it as the rasterizer would have. */
+static bool
+kk_needs_point_fill(const struct vk_graphics_pipeline_state *state,
+                    uint32_t shader_count,
+                    const struct vk_shader_compile_info *infos,
+                    enum mesa_prim *in_prim)
+{
+   if (!state || !state->rs ||
+       state->rs->polygon_mode != VK_POLYGON_MODE_POINT)
+      return false;
+
+   const nir_shader *tes = NULL;
+   for (uint32_t i = 0u; i < shader_count; ++i) {
+      /* A geometry shader's output is not handled. */
+      if (infos[i].nir->info.stage == MESA_SHADER_GEOMETRY)
+         return false;
+      if (infos[i].nir->info.stage == MESA_SHADER_TESS_EVAL)
+         tes = infos[i].nir;
+   }
+
+   if (tes) {
+      *in_prim = MESA_PRIM_TRIANGLES;
+      return tes->info.tess._primitive_mode == TESS_PRIMITIVE_TRIANGLES &&
+             !tes->info.tess.point_mode;
+   }
+
+   if (!state->ia)
+      return false;
+
+   switch (state->ia->primitive_topology) {
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN:
+      *in_prim = MESA_PRIM_TRIANGLES;
+      return true;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY:
+      *in_prim = MESA_PRIM_TRIANGLES_ADJACENCY;
+      return true;
+   default:
