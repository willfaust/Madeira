+static bool
+gather_output_stores(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct kk_output_stores *out = data;
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   struct kk_output_store st = {
+      .sem = nir_intrinsic_io_semantics(intr),
+      .component = nir_intrinsic_component(intr),
+      .num_components = util_last_bit(nir_intrinsic_write_mask(intr)),
+      .offset = nir_src_is_const(intr->src[1]) ? nir_src_as_uint(intr->src[1])
+                                               : 0u,
+      .type = nir_intrinsic_src_type(intr),
+   };
+
+   for (unsigned i = 0; i < out->count; ++i) {
+      struct kk_output_store *o = &out->stores[i];
+      if (o->sem.location == st.sem.location && o->offset == st.offset &&
+          o->component == st.component) {
+         o->num_components = MAX2(o->num_components, st.num_components);
+         return false;
+      }
+   }
+
+   assert(out->count < ARRAY_SIZE(out->stores));
+   if (out->count < ARRAY_SIZE(out->stores))
+      out->stores[out->count++] = st;
