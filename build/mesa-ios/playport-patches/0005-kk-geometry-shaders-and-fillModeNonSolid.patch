+struct kk_output_store {
+   nir_io_semantics sem;
+   unsigned component;
+   unsigned num_components;
+   unsigned offset;
+   nir_alu_type type;
+};
+
+struct kk_output_stores {
+   struct kk_output_store stores[64];
+   unsigned count;
+};
