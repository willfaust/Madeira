+/* Indirect draw with a geometry shader: read the draw, size the vertex and
+ * geometry shader grids (poly's "indirect local" layout, dispatched with
+ * dispatchThreadsWithIndirectBuffer) and allocate the vertex output buffer and,
+ * for a dynamic topology, the output index buffer from the heap.
+ */
+KERNEL(1)
+libkk_gs_setup_indirect(uint64_t index_buffer, constant uint *draw,
+                        global struct poly_vertex_params *vp,
+                        global struct poly_geometry_params *p,
+                        global struct poly_heap *heap,
+                        uint64_t vs_outputs, uint32_t index_size_B,
+                        uint32_t index_buffer_range_el, uint32_t prim,
+                        uint32_t max_indices, uint32_t shape)
+{
+   poly_gs_setup_indirect(index_buffer, draw, vp, p, heap, vs_outputs,
+                          index_size_B, index_buffer_range_el, prim,
+                          false /* no transform feedback prefix sum */,
+                          max_indices, (enum poly_gs_shape)shape);
+}
