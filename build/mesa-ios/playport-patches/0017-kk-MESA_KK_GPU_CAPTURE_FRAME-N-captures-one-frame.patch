From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Tue, 6 Oct 2026 17:00:00 +0200
Subject: [PATCH] kk: MESA_KK_GPU_CAPTURE_FRAME=N captures one frame

MESA_KK_GPU_CAPTURE=1 captures the device from its creation to its
destruction, which for a game is gigabytes a second and never ends
while it runs. With MESA_KK_GPU_CAPTURE_FRAME=N the queue counts its
presents instead and captures from the submit after present N-1 to
present N into MESA_KK_GPU_CAPTURE_DIRECTORY (the current directory when
unset) as kk-frame<N>-<time>.gputrace, as DXMT's DXMT_CAPTURE_FRAME does,
and logs "[kk] frame N: A new capture will be saved to PATH" (the line
pp gpu and pp perf find a capture by)
and "[kk] frame N: capture ended" to stderr. Metal allows it only in a
process started with MTL_CAPTURE_ENABLED=1.

Without the variable nothing changes but one counter test per submit.

Class: diagnostics
Evidence: docs/evidence/2026-10-06-vulkan-perf-tooling.md
Offered-upstream: no
---
 src/kosmickrisp/bridge/mtl_device.h         |  1 +
 src/kosmickrisp/bridge/mtl_device.m         | 23 ++++++++++++
 src/kosmickrisp/bridge/stubs/mtl_device.c   |  6 +++
 src/kosmickrisp/vulkan/kk_device.c          |  7 +++-
 src/kosmickrisp/vulkan/kk_physical_device.c |  4 ++
 src/kosmickrisp/vulkan/kk_physical_device.h |  3 ++
 src/kosmickrisp/vulkan/kk_queue.c           | 41 +++++++++++++++++++++
 src/kosmickrisp/vulkan/kk_queue.h           |  5 +++
 8 files changed, 88 insertions(+), 2 deletions(-)

diff --git a/src/kosmickrisp/bridge/mtl_device.h b/src/kosmickrisp/bridge/mtl_device.h
index 26365c1..573a9b9 100644
--- a/src/kosmickrisp/bridge/mtl_device.h
+++ b/src/kosmickrisp/bridge/mtl_device.h
@@ -21,6 +21,7 @@ mtl_device *mtl_device_create(void);
 
 /* Device operations */
 void mtl_start_gpu_capture(mtl_device *mtl_dev_handle, const char *directory);
+bool mtl_start_gpu_capture_to(mtl_device *mtl_dev_handle, const char *path);
 void mtl_stop_gpu_capture(void);
 
 /* Device feature query */
diff --git a/src/kosmickrisp/bridge/mtl_device.m b/src/kosmickrisp/bridge/mtl_device.m
index 753cda3..07fdf6d 100644
--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -63,6 +63,29 @@ mtl_start_gpu_capture(mtl_device *mtl_dev_handle, const char *directory)
    }
 }
 
+/* A capture of the device into the .gputrace at path; false when Metal
+ * refuses it (the process did not start with MTL_CAPTURE_ENABLED=1). */
+bool
+mtl_start_gpu_capture_to(mtl_device *mtl_dev_handle, const char *path)
+{
+   @autoreleasepool {
+      MTLCaptureManager *captureMgr = [MTLCaptureManager sharedCaptureManager];
+      if (![captureMgr supportsDestination: MTLCaptureDestinationGPUTraceDocument])
+         return false;
+      MTLCaptureDescriptor *captureDesc = [[MTLCaptureDescriptor new] autorelease];
+      captureDesc.captureObject = (id<MTLDevice>)mtl_dev_handle;
+      captureDesc.destination = MTLCaptureDestinationGPUTraceDocument;
+      captureDesc.outputURL = [NSURL fileURLWithPath: [NSString stringWithUTF8String: path]];
+      NSError *err = nil;
+      if (![captureMgr startCaptureWithDescriptor:captureDesc error:&err]) {
+         fprintf(stderr, "[kk] GPU capture refused (error %li): %s\n",
+                 (long)err.code, err.localizedDescription.UTF8String);
+         return false;
+      }
+      return true;
+   }
+}
+
 void
 mtl_stop_gpu_capture()
 {
diff --git a/src/kosmickrisp/bridge/stubs/mtl_device.c b/src/kosmickrisp/bridge/stubs/mtl_device.c
index 68faa46..9e9ea28 100644
--- a/src/kosmickrisp/bridge/stubs/mtl_device.c
+++ b/src/kosmickrisp/bridge/stubs/mtl_device.c
@@ -19,6 +19,12 @@ mtl_start_gpu_capture(mtl_device *mtl_dev_handle, const char *directory)
 {
 }
 
+bool
+mtl_start_gpu_capture_to(mtl_device *mtl_dev_handle, const char *path)
+{
+   return false;
+}
+
 void
 mtl_stop_gpu_capture(void)
 {
diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 96bbcac..c0cf073 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -351,7 +351,8 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
    if (result != VK_SUCCESS)
       goto fail_sampler_heap;
 
-   if (pdev->settings.gpu_capture_enabled) {
+   if (pdev->settings.gpu_capture_enabled &&
+       !pdev->settings.gpu_capture_frame) {
       const char *capture_directory =
          debug_get_option("MESA_KK_GPU_CAPTURE_DIRECTORY", NULL);
       mtl_start_gpu_capture(dev->mtl_handle, capture_directory);
@@ -399,8 +400,10 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
 
    /* End capture before we start releasing resources. Otherwise, Metal capture
     * may run into issues. */
-   if (pdev->settings.gpu_capture_enabled) {
+   if (pdev->settings.gpu_capture_enabled &&
+       (!pdev->settings.gpu_capture_frame || dev->queue.capturing)) {
       mtl_stop_gpu_capture();
+      dev->queue.capturing = false;
    }
 
    /* Meta first since it may destroy Vulkan objects */
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 5515c1f..e9c0fc8 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -1116,6 +1116,10 @@ kk_parse_environment_options(struct kk_physical_device *pdev)
 
    settings->gpu_capture_enabled =
       debug_get_bool_option("MESA_KK_GPU_CAPTURE", false);
+   settings->gpu_capture_frame =
+      debug_get_num_option("MESA_KK_GPU_CAPTURE_FRAME", 0);
+   if (settings->gpu_capture_frame)
+      settings->gpu_capture_enabled = true;
 
    const char *list = debug_get_option("MESA_KK_DISABLE_WORKAROUNDS", "");
    const char *all_workarounds = "all";
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.h b/src/kosmickrisp/vulkan/kk_physical_device.h
index 283dc9f..bc83782 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.h
+++ b/src/kosmickrisp/vulkan/kk_physical_device.h
@@ -52,6 +52,9 @@ struct kk_env_settings {
    bool experimental_enabled;
    bool gpu_capture_enabled;
    const char *gpu_capture_dir;
+   /* MESA_KK_GPU_CAPTURE_FRAME: capture only this present (counted from 1),
+    * not the device's whole life; 0 for the whole life. */
+   uint32_t gpu_capture_frame;
    uint64_t disabled_workarounds;
 };
 
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 4262593..a884614 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -8,6 +8,8 @@
 #include "kk_queue.h"
 
 #include <stdio.h>
+#include <time.h>
+#include "util/u_debug.h"
 #include "kk_buffer.h"
 #include "kk_cmd_buffer.h"
 #include "kk_device.h"
@@ -182,6 +184,42 @@ unlock:
    return result;
 }
 
+/* MESA_KK_GPU_CAPTURE_FRAME=N: capture the work of one frame, from the
+ * submit after present N-1 to present N, into
+ * MESA_KK_GPU_CAPTURE_DIRECTORY (the current directory when unset), as
+ * DXMT's DXMT_CAPTURE_FRAME does. A whole-life capture of a game is too large
+ * to keep. Metal allows it only in a process started with
+ * MTL_CAPTURE_ENABLED=1. */
+static void
+kk_queue_capture_frame(struct kk_queue *queue, bool presented)
+{
+   struct kk_device *dev = kk_queue_device(queue);
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+   uint32_t frame = pdev->settings.gpu_capture_frame;
+
+   if (!frame)
+      return;
+   if (presented)
+      queue->presents++;
+   if (!queue->capturing && queue->presents == frame - 1u && !presented) {
+      const char *dir = debug_get_option("MESA_KK_GPU_CAPTURE_DIRECTORY", ".");
+      char path[1024];
+      snprintf(path, sizeof(path), "%s/kk-frame%u-%ld.gputrace", dir, frame,
+               (long)time(NULL));
+      queue->capturing = mtl_start_gpu_capture_to(dev->mtl_handle, path);
+      if (queue->capturing)
+         fprintf(stderr, "[kk] frame %u: A new capture will be saved to %s\n", frame, path);
+      else
+         fprintf(stderr, "[kk] frame %u: capture refused (%s)\n", frame, path);
+      fflush(stderr);
+   } else if (queue->capturing && queue->presents == frame) {
+      mtl_stop_gpu_capture();
+      queue->capturing = false;
+      fprintf(stderr, "[kk] frame %u: capture ended\n", frame);
+      fflush(stderr);
+   }
+}
+
 static VkResult
 kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
 {
@@ -191,6 +229,8 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    if (vk_queue_is_lost(&queue->vk))
       return VK_ERROR_DEVICE_LOST;
 
+   kk_queue_capture_frame(queue, false);
+
    for (struct vk_sync_wait *wait = submit->waits,
                             *end = submit->waits + submit->wait_count;
         wait != end; ++wait) {
@@ -230,6 +270,7 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
                                            cmd_buffer->drawable);
          mtl_release(cmd_buffer->drawable);
          cmd_buffer->drawable = NULL;
+         kk_queue_capture_frame(queue, true);
       }
    }
 
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index ddc9a3c..1107482 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -31,6 +31,11 @@ struct kk_queue {
    uint32_t commits_in_flight;
    mtx_t mutex;
    cnd_t cond;
+
+   /* Presents submitted so far, and whether a one-frame GPU capture
+    * (MESA_KK_GPU_CAPTURE_FRAME) is running. */
+   uint32_t presents;
+   bool capturing;
 };
 
 static inline struct kk_device *
