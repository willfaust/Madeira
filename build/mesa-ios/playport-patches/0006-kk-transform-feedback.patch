diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
index 4b143ca..bde238d 100644
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -55,10 +55,53 @@ libkk_gs_setup_indirect(uint64_t index_buffer, constant uint *draw,
                         global struct poly_heap *heap,
                         uint64_t vs_outputs, uint32_t index_size_B,
                         uint32_t index_buffer_range_el, uint32_t prim,
-                        uint32_t max_indices, uint32_t shape)
+                        uint32_t is_prefix_summing, uint32_t max_indices,
+                        uint32_t shape)
 {
    poly_gs_setup_indirect(index_buffer, draw, vp, p, heap, vs_outputs,
                           index_size_B, index_buffer_range_el, prim,
-                          false /* no transform feedback prefix sum */,
-                          max_indices, (enum poly_gs_shape)shape);
+                          is_prefix_summing, max_indices,
+                          (enum poly_gs_shape)shape);
+}
+
+/* Prefix sum the geometry count buffer, one workgroup per count word. */
+KERNEL(1024)
+libkk_prefix_sum_geom(constant struct poly_geometry_params *p)
+{
+   local uint scratch[32];
+   poly_prefix_sum(scratch, p->count_buffer, p->input_primitives,
+                   p->count_buffer_stride / 4, cl_group_id.x, 1024);
+}
+
+/* vkCmdBeginTransformFeedbackEXT and vkCmdEndTransformFeedbackEXT: copy
+ * transform feedback byte offsets between counter buffers and the command
+ * buffer's offsets. A null source reads as zero. */
+KERNEL(4)
+libkk_copy_xfb_counters(global uint32_t *dest0, global uint32_t *dest1,
+                        global uint32_t *dest2, global uint32_t *dest3,
+                        global uint32_t *src0, global uint32_t *src1,
+                        global uint32_t *src2, global uint32_t *src3)
+{
+   uint i = cl_local_id.x;
+   global uint32_t *dest = i == 0 ? dest0 : i == 1 ? dest1 : i == 2 ? dest2 : dest3;
+   global uint32_t *src = i == 0 ? src0 : i == 1 ? src1 : i == 2 ? src2 : src3;
+
+   if (dest)
+      *dest = src ? *src : 0;
+}
+
+/* vkCmdDrawIndirectByteCountEXT: the vertex count is the bytes the counter
+ * says were captured past counter_offset, divided by the vertex stride. */
+KERNEL(1)
+libkk_draw_indirect_byte_count(global uint32_t *out_draw,
+                               constant uint32_t *byte_count,
+                               uint32_t counter_offset, uint32_t stride,
+                               uint32_t instance_count,
+                               uint32_t first_instance)
+{
+   int bytes = (int)(*byte_count) - (int)counter_offset;
+   out_draw[0] = stride ? (uint)max(bytes, 0) / stride : 0; /* vertexCount */
+   out_draw[1] = instance_count;
+   out_draw[2] = 0;                                         /* firstVertex */
+   out_draw[3] = first_instance;
 }
