# Reference/scratch material — not build inputs.
# research/* rather than research/, so specific subdirectories can be
# re-included; git will not descend into a directory ignored with a trailing
# slash, which makes any negation inside it silently ineffective.
research/*
!research/remote-metal/
!research/metal-blend-test/
*.bak
photorec.se2
.DS_Store

# Build/deploy artifacts (regenerable; keep them out of history)
*.ipa
clean-prefix/
